# Docker 部署环境变量配置
# 复制此文件为 .env 并修改配置

# JWT 密钥（必须修改！请生成随机字符串）
# 生成命令: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_change_me
JWT_REFRESH_SECRET=your_refresh_secret_here_change_me
JWT_DOWNLOAD_SECRET=your_download_secret_here_change_me

# CORS 配置（修改为你的实际域名）
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# 默认学期
DEFAULT_SEMESTER=2025-2026-2
