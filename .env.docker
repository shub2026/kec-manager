# Docker 部署环境变量配置
# 复制此文件为 .env 并修改配置

# JWT 密钥（必须修改！请生成随机字符串）
# 生成命令: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_change_me
JWT_REFRESH_SECRET=your_refresh_secret_here_change_me
JWT_DOWNLOAD_SECRET=your_download_secret_here_change_me

# CORS 配置（修改为你的实际域名）
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# 默认学期
DEFAULT_SEMESTER=2025-2026-2

# 【可选】Docker 构建基础镜像地址（国内服务器建议配置）
# BuildKit 不读 daemon.json 的镜像加速，必须在此显式指定
# 不配置时默认官方 node:20-alpine（国内网络构建可能卡死）
# 示例：NODE_IMAGE=<你的镜像加速地址>/library/node:20-alpine
# NODE_IMAGE=

# 【可选】应用镜像版本标签（建议与 package.json 的 version 保持一致，如 v1.4.1）
# 不配置时默认 latest
# APP_VERSION=v1.4.1

# 【可选】镜像仓库地址（用于 docker push 发布 + 按版本回滚）
# 不配置时镜像仅本地命名 kec-manager:<APP_VERSION>
# 示例：IMAGE_REPO=registry.example.com/kec-manager
# IMAGE_REPO=

