# ============================================================
# KEC 课程管理平台 - Docker 部署环境变量
# 使用方法：复制为 .env 并修改配置值
#   cp .env.docker .env
#   docker compose up -d
# ============================================================

# ---------- 必填：JWT 密钥 ----------
# 生产环境请使用随机生成的强密码（建议 32 字符以上）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=替换为随机字符串
JWT_REFRESH_SECRET=替换为随机字符串
JWT_DOWNLOAD_SECRET=替换为随机字符串

# ---------- 必填：当前学期 ----------
# 格式：YYYY-YYYY-N（如 2025-2026-2 = 2025-2026学年第2学期）
DEFAULT_SEMESTER=2025-2026-2

# ---------- 必填：CORS 允许的域名 ----------
# 多个域名用逗号分隔，例如：https://kec.example.com,http://localhost
CORS_ORIGINS=https://your-domain.com

# ---------- 可选：容器配置 ----------
CONTAINER_PREFIX=kec
SERVER_PORT=3000
CLIENT_PORT=80
NETWORK_NAME=kec-network

# ---------- 可选：JWT 过期时间 ----------
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- 可选：安全参数 ----------
BCRYPT_ROUNDS=12

# ---------- 可选：日志级别 ----------
# 可选值：error, warn, info, http, debug
LOG_LEVEL=info
