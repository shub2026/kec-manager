/* ===== 设计系统（全局） ===== */
page {
  background: #f5f6f8;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  color: #1a1a1a;
  font-size: 28rpx;
}
.page { padding: 24rpx; box-sizing: border-box; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-title .more { font-size: 24rpx; color: #07c160; font-weight: 400; }

/* 指标网格 */
.stat-grid { display: flex; flex-wrap: wrap; margin: -8rpx; }
.stat-cell {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}
.stat-inner {
  background: #f7faf8;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
}
.stat-num { font-size: 44rpx; font-weight: 700; color: #07c160; line-height: 1.2; }
.stat-num.small { font-size: 36rpx; }
.stat-label { font-size: 24rpx; color: #8a8a8a; margin-top: 8rpx; }

/* 列表 / 行 */
.list { background: #fff; border-radius: 16rpx; overflow: hidden; }
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.row:last-child { border-bottom: none; }
.row .label { color: #8a8a8a; font-size: 26rpx; }
.row .value { color: #1a1a1a; font-size: 28rpx; text-align: right; }
.row.arrow::after {
  content: "›";
  color: #c8c8c8;
  font-size: 36rpx;
  margin-left: 12rpx;
}

/* 文本 */
.muted { color: #8a8a8a; }
.small { font-size: 24rpx; }
.center { text-align: center; }
.mt { margin-top: 20rpx; }
.mb { margin-bottom: 20rpx; }

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #07c160;
  background: #e8f8ef;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-right: 10rpx;
  margin-top: 10rpx;
}
.tag.warn { color: #e08a00; background: #fdf3e3; }

/* 按钮 */
.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.btn-ghost {
  background: #fff;
  color: #07c160;
  border: 1rpx solid #07c160;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* 进度条 */
.bar { height: 16rpx; background: #eef0f2; border-radius: 8rpx; overflow: hidden; }
.bar > view { height: 100%; background: #07c160; border-radius: 8rpx; }

/* 状态 */
.empty { text-align: center; color: #b0b0b0; padding: 80rpx 0; font-size: 26rpx; }
.loading { text-align: center; color: #b0b0b0; padding: 40rpx 0; font-size: 26rpx; }
.errbox {
  background: #fff3f3;
  color: #d4380d;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}
