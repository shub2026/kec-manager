.login {
  min-height: 100vh;
  padding: 0 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: linear-gradient(180deg, #E8F4FD 0%, #f5f6f8 40%);
}

.brand {
  text-align: center;
  margin-bottom: 56rpx;
}
.logo {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 24rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.subtitle {
  font-size: 26rpx;
  color: #8a8a8a;
  margin-top: 12rpx;
}

.form {
  padding: 40rpx 36rpx;
}
.field {
  margin-bottom: 28rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #8a8a8a;
  margin-bottom: 12rpx;
}
.input {
  height: 84rpx;
  line-height: 84rpx;
  background: #F5FAFF;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}
.submit {
  margin-top: 12rpx;
  height: 88rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip {
  text-align: center;
  font-size: 24rpx;
  color: #b0b0b0;
  margin-top: 40rpx;
}
