<view class="login">
  <view class="brand">
    <image class="logo" src="/assets/logo.png" mode="aspectFit" />
    <view class="title">KEC课程管理平台</view>
    <view class="subtitle">轻量级教学管理系统</view>
  </view>

  <view class="form card">
    <view class="field">
      <view class="field-ico ico-user"></view>
      <input
        class="input"
        placeholder="请输入用户名"
        placeholder-class="ph"
        value="{{username}}"
        confirm-type="next"
        cursor-spacing="20"
        adjust-position
        bindinput="onUsername"
        bindconfirm="onUsernameConfirm"
      />
    </view>

    <view class="field">
      <view class="field-ico ico-lock"></view>
      <input
        class="input"
        placeholder="请输入密码"
        placeholder-class="ph"
        password="{{!showPassword}}"
        value="{{password}}"
        focus="{{pwdFocus}}"
        confirm-type="done"
        cursor-spacing="20"
        adjust-position
        bindinput="onPassword"
        bindconfirm="onSubmit"
      />
      <view class="eye {{showPassword ? 'eye-on' : ''}}" bindtap="togglePassword">
        <view class="eye-ico"></view>
      </view>
    </view>

    <view wx:if="{{error}}" class="errbox">{{error}}</view>

    <button class="btn-primary submit" loading="{{loading}}" bindtap="onSubmit">登录</button>
  </view>

  <view class="tip">体验版仅供内部测试人员使用</view>
</view>
