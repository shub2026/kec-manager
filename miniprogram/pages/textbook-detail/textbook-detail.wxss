.book-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 24rpx;
  line-height: 1.4;
}
.book-meta {
  margin-bottom: 24rpx;
}
.bm-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.bm-row:last-child { border-bottom: none; }
.bm-row .label {
  font-size: 26rpx;
  color: var(--text-3);
  flex-shrink: 0;
  margin-right: 24rpx;
}
.bm-row .value {
  font-size: 26rpx;
  color: var(--text-1);
  text-align: right;
  flex: 1;
  word-break: break-all;
}
.book-tag {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-light);
}

/* ===== 使用班级 ===== */
.cls-item {
  border-bottom: 1rpx solid var(--border-light);
  padding: 18rpx 0;
}
.cls-item:last-child { border-bottom: none; padding-bottom: 0; }
.cls-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cls-name {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
}
.cls-name text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.req {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-soft);
  padding: 2rpx 8rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.con {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: var(--success-dark);
  background: var(--success-soft);
  padding: 2rpx 8rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.cls-detail {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--bg-page);
  border-radius: var(--radius-md);
}
.cd-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 24rpx;
}
.cd-row .label { color: var(--text-3); }
.cd-row .value { color: var(--text-2); font-weight: 500; }
