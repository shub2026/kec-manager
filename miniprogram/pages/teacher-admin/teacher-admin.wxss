/* 筛选栏（与教师课时页一致） */
.filter-bar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 36rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: #1C82F5;
}
.filter-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
}
.filter-picker {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #8a8a8a;
  background: #fff;
  border: 1rpx solid #e3e6ea;
  border-radius: 36rpx;
  padding: 14rpx 24rpx;
}
.filter-picker.active { color: #1C82F5; border-color: #1C82F5; }
.filter-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #1C82F5;
}

/* 局部刷新提示（顶部细条，不遮挡列表、不卸载搜索框） */
.top-loading {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.top-loading-bar {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  border: 4rpx solid #e3e6ea;
  border-top-color: #1C82F5;
  border-radius: 50%;
  animation: tl-spin 0.7s linear infinite;
}
.top-loading-text {
  font-size: 24rpx;
  color: #8a8a8a;
}
@keyframes tl-spin {
  to { transform: rotate(360deg); }
}

/* 教师卡片 */
.teacher-card { padding: 24rpx 28rpx; }
.tc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tc-left { flex: 1; min-width: 0; }
.tc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.tc-sub {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.tc-divider {
  color: #d1d5db;
  margin: 0 10rpx;
  transform: scaleY(0.8);
}
.tc-right { flex-shrink: 0; margin-left: 16rpx; display: flex; flex-direction: column; align-items: flex-end; }
.tc-edit {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #1C82F5;
  background: #e8f3fe;
  border: 1rpx solid #bfdbfe;
  border-radius: 24rpx;
  padding: 6rpx 22rpx;
}
.tc-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

/* 人员类别标签（复用全局 .pt 体系） */
.pt {
  display: inline-block;
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-left: 10rpx;
  font-weight: 400;
}
.pt-success { color: #10b981; background: #e7f8f2; }
.pt-warning { color: #ff6b1a; background: #fff0e8; }
.pt-info { color: #64748b; background: #f1f5f9; }
.pt-disabled { color: #b0b0b0; background: #f1f5f9; }

/* 学科标签 */
.tag-blue {
  color: #1C82F5;
  background: #e8f3fe;
  border-color: #bfdbfe;
}
.tag-more {
  color: #94a3b8;
  background: #f8fafc;
  border-color: #e2e8f0;
}

/* 列表底部 */
.list-end {
  text-align: center;
  color: #b0b0b0;
  font-size: 24rpx;
  padding: 24rpx 0;
}

/* 悬浮新增按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  background: #1C82F5;
  color: #fff;
  font-size: 28rpx;
  padding: 22rpx 36rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(28, 130, 245, 0.35);
  z-index: 50;
}

/* 新增弹层 */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.field-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  flex-shrink: 0;
}
.req { color: #f87171; margin-left: 4rpx; }
.field-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}
.field-picker { flex: 1; }
.field-picker-text {
  font-size: 28rpx;
  text-align: right;
  color: #1a1a1a;
}
.field-picker-text.ph { color: #b0b0b0; }
.field-block { display: block; }
.field-block .field-label { display: block; width: auto; margin-bottom: 16rpx; }
.field-hint {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-left: 12rpx;
  font-weight: 400;
}
.field-loading,
.field-empty {
  font-size: 26rpx;
  color: #8a8a8a;
  padding: 12rpx 0;
}
.course-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-bottom: 8rpx;
}
.course-chip {
  font-size: 26rpx;
  color: #475569;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  border-radius: 28rpx;
  padding: 10rpx 24rpx;
}
.course-chip-selected {
  color: #1C82F5;
  background: #e8f3fe;
  border-color: #1C82F5;
}
.sheet-actions {
  display: flex;
  margin-top: 32rpx;
}
.sheet-btn {
  flex: 1;
  margin: 0 10rpx;
}
.placeholder { color: #b0b0b0; }
