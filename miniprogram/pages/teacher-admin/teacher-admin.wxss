/* ===== 教师卡片 ===== */
.teacher-card {
  padding: 0;
  overflow: hidden;
}
.teacher-card.disabled {
  border-left: 4rpx solid var(--danger);
}
.tc-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx;
}
.tc-left { flex: 1; min-width: 0; }
.tc-name {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 10rpx;
}
.tc-sub {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.tc-divider { color: var(--text-5); }
.pt {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-subtle);
  color: var(--text-3);
  font-weight: 500;
}
.pt-internal { color: var(--brand); background: var(--brand-soft); }
.pt-external { color: var(--success-dark); background: var(--success-soft); }
.pt-disabled { color: var(--danger-dark); background: var(--danger-soft); }
.tc-right {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.tc-edit {
  font-size: 24rpx;
  color: var(--brand);
  background: var(--brand-soft);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  text-align: center;
}
.tc-del {
  font-size: 24rpx;
  color: var(--danger-dark);
  background: var(--danger-soft);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  text-align: center;
}
.tc-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 0 28rpx 24rpx;
  border-top: 1rpx solid var(--border-light);
  padding-top: 18rpx;
}
.tag-blue {
  color: var(--brand);
  background: var(--brand-soft);
}
.tag-more {
  color: var(--text-4);
  background: transparent;
}

/* ===== 顶部加载 / 列表底部 ===== */
.top-loading { margin-bottom: 16rpx; }
.top-loading-bar {
  height: 4rpx;
  background: var(--brand);
  border-radius: 2rpx;
  margin-bottom: 8rpx;
  animation: shimmer 1s infinite;
}
.top-loading-text {
  font-size: 22rpx;
  color: var(--text-4);
  text-align: center;
  display: block;
}
@keyframes shimmer {
  0% { opacity: 0.5; }
  50% { opacity: 1; }
  100% { opacity: 0.5; }
}
.list-end {
  text-align: center;
  color: var(--text-4);
  font-size: 24rpx;
  padding: 20rpx 0 40rpx;
}

/* ===== 悬浮按钮 ===== */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 50;
  background: var(--brand);
  color: var(--bg-card);
  font-size: 28rpx;
  font-weight: 500;
  padding: 22rpx 32rpx;
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-md);
}

/* scroll-view 必须显式高度 */
.sheet-scroll {
  flex: 1;
  min-height: 0;
  height: calc(88vh - 200rpx);
  padding: 8rpx 32rpx 16rpx;
  box-sizing: border-box;
}
.sheet-form {
  padding-bottom: 16rpx;
}
/* 分组标题：左侧品牌 accent 条，与全局 card-title 语言一致 */
.form-section {
  margin-bottom: 32rpx;
}
.form-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 18rpx;
  letter-spacing: -0.2rpx;
}
/* 表单行：细线 + 圆角 + 聚焦品牌蓝边 */
.form-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 4rpx;
  margin-bottom: 20rpx;
  position: relative;
}
.form-row::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--border-light);
  transform: scaleY(0.5);
}
.form-row:last-child { margin-bottom: 0; }
.form-row:last-child::after { display: none; }
.form-row-focus { background: transparent; }
.form-row-focus::after {
  background: var(--brand);
  transform: scaleY(1);
}
.form-row-label {
  width: 156rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: var(--text-2);
}
.form-row-label .req { color: var(--danger); margin-left: 4rpx; font-weight: 600; }
.form-row-input {
  flex: 1;
  height: 92rpx;
  font-size: 28rpx;
  color: var(--text-1);
  min-width: 0;
}
.form-row-input-focus { background: transparent; }
.form-row-picker { flex: 1; }
.form-row-picker-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 92rpx;
}
.form-row-picker-text {
  font-size: 28rpx;
  color: var(--text-1);
}
.form-row-picker-text.ph { color: var(--text-3); }
.picker-arrow {
  width: 20rpx;
  height: 20rpx;
  border-top: 2rpx solid var(--text-4);
  border-right: 2rpx solid var(--text-4);
  transform: rotate(45deg);
  margin-right: 6rpx;
}
.form-row-static {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-3);
}
.field-hint {
  font-size: 22rpx;
  color: var(--text-3);
  font-weight: 400;
  margin-left: 12rpx;
}
.field-loading, .field-empty {
  color: var(--text-4);
  font-size: 26rpx;
  padding: 24rpx 0;
  text-align: center;
}
.course-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.course-chip {
  font-size: 24rpx;
  color: var(--text-2);
  background: var(--bg-subtle);
  border-radius: var(--radius-pill);
  padding: 12rpx 22rpx;
  transition: all 0.15s ease;
}
.course-chip-selected {
  color: #fff;
  background: var(--brand);
}

