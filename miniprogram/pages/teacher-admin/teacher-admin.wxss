/* 筛选栏（与教师课时页一致） */
.filter-bar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 36rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: #1C82F5;
}
.filter-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
}
.filter-picker {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #8a8a8a;
  background: #fff;
  border: 1rpx solid #e3e6ea;
  border-radius: 36rpx;
  padding: 14rpx 24rpx;
}
.filter-picker.active { color: #1C82F5; border-color: #1C82F5; }
.filter-clear {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #1C82F5;
}

/* 局部刷新提示（顶部细条，不遮挡列表、不卸载搜索框） */
.top-loading {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.top-loading-bar {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  border: 4rpx solid #e3e6ea;
  border-top-color: #1C82F5;
  border-radius: 50%;
  animation: tl-spin 0.7s linear infinite;
}
.top-loading-text {
  font-size: 24rpx;
  color: #8a8a8a;
}
@keyframes tl-spin {
  to { transform: rotate(360deg); }
}

/* 教师卡片 */
.teacher-card { padding: 24rpx 28rpx; }
.tc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tc-left { flex: 1; min-width: 0; }
.tc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.tc-sub {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.tc-divider {
  color: #d1d5db;
  margin: 0 10rpx;
  transform: scaleY(0.8);
}
.tc-right { flex-shrink: 0; margin-left: 16rpx; display: flex; flex-direction: column; align-items: flex-end; }
.tc-edit {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #1C82F5;
  background: #e8f3fe;
  border: 1rpx solid #bfdbfe;
  border-radius: 24rpx;
  padding: 6rpx 22rpx;
}
.tc-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

/* 人员类别标签（复用全局 .pt 体系） */
.pt {
  display: inline-block;
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-left: 10rpx;
  font-weight: 400;
}
.pt-success { color: #10b981; background: #e7f8f2; }
.pt-warning { color: #ff6b1a; background: #fff0e8; }
.pt-info { color: #64748b; background: #f1f5f9; }
.pt-disabled { color: #b0b0b0; background: #f1f5f9; }

/* 学科标签 */
.tag-blue {
  color: #1C82F5;
  background: #e8f3fe;
  border-color: #bfdbfe;
}
.tag-more {
  color: #94a3b8;
  background: #f8fafc;
  border-color: #e2e8f0;
}

/* 列表底部 */
.list-end {
  text-align: center;
  color: #b0b0b0;
  font-size: 24rpx;
  padding: 24rpx 0;
}

/* 悬浮新增按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  background: #1C82F5;
  color: #fff;
  font-size: 28rpx;
  padding: 22rpx 36rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(28, 130, 245, 0.35);
  z-index: 50;
}

/* 新增弹层 */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  height: 88vh;
  max-height: 88vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 20rpx 48rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.sheet-header {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 18rpx;
}
.sheet-handle {
  width: 44rpx;
  height: 5rpx;
  background: #d1d5db;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: 0.6rpx;
}
.sheet-scroll {
  flex: 1;
  min-height: 0;
  margin: 0 -48rpx;
  padding: 0 48rpx;
}
.sheet-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}
.sheet-form { padding-bottom: 240rpx; }
.form-section { margin-bottom: 32rpx; }
.form-section-last { margin-bottom: 0; }
.form-section-title {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-bottom: 14rpx;
  padding-left: 4rpx;
  font-weight: 500;
  letter-spacing: 0.4rpx;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-row:last-child { border-bottom: none; }
.form-row-focus { border-bottom-color: #1C82F5; }
.form-row-label {
  width: 170rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  flex-shrink: 0;
  font-weight: 500;
}
.req { color: #f87171; margin-left: 4rpx; }
.form-row-input,
.form-row-picker {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #111827;
  text-align: right;
  height: 44rpx;
  line-height: 44rpx;
  background: transparent;
  padding: 0;
}
.form-row-input-focus { color: #1C82F5; }
.form-row-picker {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.form-row-picker-inner {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.form-row-picker-text {
  font-size: 28rpx;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1;
}
.form-row-picker-text.ph { color: #9ca3af; }
.picker-arrow {
  width: 0;
  height: 0;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-top: 8rpx solid #c1c7ce;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.field-hint {
  font-size: 24rpx;
  color: #9ca3af;
  margin-left: 10rpx;
  font-weight: 400;
}
.field-loading,
.field-empty {
  font-size: 26rpx;
  color: #9ca3af;
  padding: 16rpx 4rpx;
}
.course-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 4rpx 12rpx;
}
.course-chip {
  position: relative;
  font-size: 26rpx;
  color: #4b5563;
  background: #f3f4f6;
  border: 1rpx solid #e5e7eb;
  border-radius: 28rpx;
  padding: 10rpx 24rpx;
  line-height: 1.35;
  transition: all 0.12s ease;
}
.course-chip:active {
  transform: scale(0.96);
  background: #e5e7eb;
}
.course-chip-selected {
  color: #fff;
  background: #1C82F5;
  border-color: #1C82F5;
  box-shadow: 0 4rpx 12rpx rgba(28, 130, 245, 0.22);
}
.sheet-actions {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  padding-top: 20rpx;
  background: #fff;
  gap: 24rpx;
}
.sheet-actions::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 100%;
  height: 60rpx;
  background: linear-gradient(to top, rgba(255, 255, 255, 1), rgba(255, 255, 255, 0));
  pointer-events: none;
}
.sheet-btn {
  flex: 1;
  display: flex !important;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 !important;
  height: 90rpx;
  line-height: 1;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0.8rpx;
  border-radius: 18rpx;
  transition: all 0.12s ease;
}
.sheet-btn::after { border: none; }
.sheet-btn[disabled] { opacity: 0.55; }
.btn-ghost.sheet-btn {
  background: #f3f4f6;
  color: #4b5563;
}
.btn-ghost.sheet-btn:active { background: #e5e7eb; }
.btn-primary.sheet-btn {
  background: linear-gradient(135deg, #1C82F5 0%, #3b95f7 100%);
  box-shadow: 0 8rpx 24rpx rgba(28, 130, 245, 0.28);
}
.btn-primary.sheet-btn:active {
  box-shadow: 0 4rpx 14rpx rgba(28, 130, 245, 0.2);
  transform: translateY(1rpx);
}
.placeholder { color: #9ca3af; }
