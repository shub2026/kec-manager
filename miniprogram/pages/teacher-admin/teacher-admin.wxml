<view class="page">
  <!-- Hero -->
  <view class="hero">
    <view class="hero-card">
      <view class="hero-text">
        <view class="hero-title">教师管理</view>
        <view class="hero-subtitle">查询教师档案，管理员可新增</view>
        <view class="hero-badge"><text class="hero-badge-text">共 {{total}} 位教师</text></view>
      </view>
      <view class="hero-decor"><view class="hero-ring"></view></view>
    </view>
  </view>

  <!-- 仅首屏（列表为空）显示全屏遮罩；其余状态筛选栏始终挂载，避免输入时卸载搜索框 -->
  <view wx:if="{{loading && teachers.length === 0}}" class="loading">加载中…</view>

  <block wx:else>
    <!-- 筛选栏 -->
    <view class="filter-bar">
      <view class="search-box">
        <text class="search-icon">🔍</text>
        <input class="filter-input" value="{{searchName}}" placeholder="搜索姓名" placeholder-class="placeholder" bindinput="onNameInput" />
      </view>
      <picker mode="selector" range="{{personnelOptions}}" bindchange="onPersonnelChange">
        <view class="filter-picker {{filterPersonnel ? 'active' : ''}}">
          {{filterPersonnelLabel ? filterPersonnelLabel : '人员类别'}} ›
        </view>
      </picker>
        <text wx:if="{{searchName || filterPersonnel}}" class="filter-clear" bindtap="clearFilters">重置</text>
      </view>

      <!-- 局部刷新提示（输入/筛选时显示，不遮挡列表） -->
      <view wx:if="{{refreshing && teachers.length}}" class="top-loading">
        <view class="top-loading-bar"></view>
        <text class="top-loading-text">刷新中…</text>
      </view>

      <!-- 行内错误提示（不替换筛选栏，避免输入失焦） -->
      <view wx:if="{{error}}" class="errbox">{{error}}</view>

      <!-- 教师列表 -->
    <view wx:if="{{teachers.length}}">
      <view wx:for="{{teachers}}" wx:key="id" class="card teacher-card">
        <view class="tc-head">
          <view class="tc-left">
            <view class="tc-name">
              {{item.name}}
              <text wx:if="{{item.personnelType}}" class="pt pt-{{item.personnelClass}}">{{item.personnelType}}</text>
              <text wx:if="{{item.status === 'disabled'}}" class="pt pt-disabled">已停用</text>
            </view>
            <view class="tc-sub">
              <text>{{item.college}}</text>
              <text class="tc-divider">|</text>
              <text>{{item.gender}}</text>
              <text class="tc-divider">|</text>
              <text>{{item.birthDate}}</text>
              <text class="tc-divider">|</text>
              <text>课时 {{item.defaultWeeklyHours}}</text>
            </view>
          </view>
          <view class="tc-right">
            <view wx:if="{{canManage}}" class="tc-edit" catchtap="openEdit" data-id="{{item.id}}">编辑</view>
          </view>
        </view>
        <view class="tc-meta">
          <text class="tag">资格：{{item.qualification}}</text>
          <block wx:if="{{item.courseList.length}}">
            <text wx:for="{{item.courseList}}" wx:key="id" wx:for-item="c" class="tag tag-blue">{{c.name}}</text>
            <text wx:if="{{item.courseListMore}}" class="tag tag-more">{{item.courseListMore}}</text>
          </block>
        </view>
      </view>

      <view wx:if="{{finished}}" class="list-end">已显示全部 {{total}} 位教师</view>
      <view wx:else class="loading">加载更多…</view>
    </view>

    <view wx:else class="empty">{{searchName || filterPersonnel ? '未找到匹配的教师' : '暂无教师数据'}}</view>
  </block>

  <!-- 管理员：悬浮新增按钮 -->
  <view wx:if="{{canManage}}" class="fab" bindtap="openAdd">＋ 新增教师</view>
</view>

<!-- 新增 / 编辑 教师弹层 -->
<view wx:if="{{showSheet}}" class="mask" bindtap="closeSheet">
  <view class="sheet" catchtap="noop">
    <view class="sheet-header">
      <view class="sheet-handle"></view>
      <view class="sheet-title">{{sheetTitle}}</view>
    </view>

    <scroll-view class="sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="sheet-form">
        <!-- 基本信息 -->
        <view class="form-section">
          <view class="form-section-title">基本信息</view>
          <view class="form-row {{focusedField === 'name' ? 'form-row-focus' : ''}}">
            <text class="form-row-label">姓名<text class="req">*</text></text>
            <input class="form-row-input {{focusedField === 'name' ? 'form-row-input-focus' : ''}}" value="{{form.name}}" data-field="name" placeholder="请输入教师姓名" placeholder-class="placeholder" bindinput="onFormInput" bindfocus="onFormFocus" bindblur="onFormBlur" />
          </view>
          <view class="form-row">
            <text class="form-row-label">性别</text>
            <picker class="form-row-picker" mode="selector" range="{{genderOptions}}" value="{{form.genderIndex}}" bindchange="onGenderPick">
              <view class="form-row-picker-inner">
                <view class="form-row-picker-text {{form.genderIndex >= 0 ? '' : 'ph'}}">{{form.genderIndex >= 0 ? genderOptions[form.genderIndex] : '请选择'}}</view>
                <view class="picker-arrow"></view>
              </view>
            </picker>
          </view>
          <view class="form-row">
            <text class="form-row-label">人员类别</text>
            <picker class="form-row-picker" mode="selector" range="{{personnelLabels}}" value="{{form.personnelIndex}}" bindchange="onPersonnelPick">
              <view class="form-row-picker-inner">
                <view class="form-row-picker-text {{form.personnelIndex >= 0 ? '' : 'ph'}}">{{form.personnelIndex >= 0 ? personnelLabels[form.personnelIndex] : '请选择'}}</view>
                <view class="picker-arrow"></view>
              </view>
            </picker>
          </view>
          <view class="form-row">
            <text class="form-row-label">归属学院</text>
            <picker class="form-row-picker" mode="selector" range="{{collegeNames}}" value="{{form.collegeIndex}}" bindchange="onCollegePick">
              <view class="form-row-picker-inner">
                <view class="form-row-picker-text {{form.collegeIndex >= 0 ? '' : 'ph'}}">{{form.collegeIndex >= 0 ? collegeNames[form.collegeIndex] : '请选择'}}</view>
                <view class="picker-arrow"></view>
              </view>
            </picker>
          </view>
        </view>

        <!-- 工作信息 -->
        <view class="form-section">
          <view class="form-section-title">工作信息</view>
          <view class="form-row">
            <text class="form-row-label">状态</text>
            <picker class="form-row-picker" mode="selector" range="{{statusLabels}}" value="{{form.statusIndex}}" bindchange="onStatusPick">
              <view class="form-row-picker-inner">
                <view class="form-row-picker-text">{{statusLabels[form.statusIndex]}}</view>
                <view class="picker-arrow"></view>
              </view>
            </picker>
          </view>
          <view class="form-row {{focusedField === 'birthDate' ? 'form-row-focus' : ''}}">
            <text class="form-row-label">出生年月</text>
            <input class="form-row-input {{focusedField === 'birthDate' ? 'form-row-input-focus' : ''}}" value="{{form.birthDate}}" data-field="birthDate" placeholder="如：1974-03" placeholder-class="placeholder" bindinput="onFormInput" bindfocus="onFormFocus" bindblur="onFormBlur" />
          </view>
          <view class="form-row {{focusedField === 'qualification' ? 'form-row-focus' : ''}}">
            <text class="form-row-label">资格类型</text>
            <input class="form-row-input {{focusedField === 'qualification' ? 'form-row-input-focus' : ''}}" value="{{form.qualification}}" data-field="qualification" placeholder="如：讲师" placeholder-class="placeholder" bindinput="onFormInput" bindfocus="onFormFocus" bindblur="onFormBlur" />
          </view>
          <view class="form-row {{focusedField === 'weeklyHours' ? 'form-row-focus' : ''}}">
            <text class="form-row-label">自定义课时</text>
            <input class="form-row-input {{focusedField === 'weeklyHours' ? 'form-row-input-focus' : ''}}" type="digit" value="{{form.weeklyHours}}" data-field="weeklyHours" placeholder="如：16" placeholder-class="placeholder" bindinput="onFormInput" bindfocus="onFormFocus" bindblur="onFormBlur" />
          </view>
        </view>

        <!-- 学科 -->
        <view class="form-section form-section-last">
          <view class="form-section-title">学科（课程）<text class="field-hint">选填 · 可多选</text></view>
          <view wx:if="{{!courseLoaded}}" class="field-loading">加载学科列表…</view>
          <view wx:elif="{{courseOptions.length === 0}}" class="field-empty">暂无学科</view>
          <view wx:else class="course-chips">
            <view
              wx:for="{{courseOptions}}"
              wx:key="id"
              class="course-chip {{item.selected ? 'course-chip-selected' : ''}}"
              bindtap="toggleCourse"
              data-id="{{item.id}}"
            >{{item.name}}</view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="sheet-actions">
      <button class="btn-ghost sheet-btn" disabled="{{submitting}}" bindtap="closeSheet">取消</button>
      <button class="btn-primary sheet-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">保存</button>
    </view>
  </view>
</view>
