/* ===== 用户卡片 ===== */
.user-card {
  padding: 0;
  overflow: hidden;
}
.user-card.disabled {
  border-left: 4rpx solid var(--danger);
}
.uc-head {
  display: flex;
  align-items: flex-start;
  padding: 28rpx;
}
.uc-left { flex: 1; min-width: 0; }
.uc-name {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 10rpx;
}
.uc-sub {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 8rpx;
}
.uc-divider { color: var(--text-5); }
.uc-email {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 240rpx;
}
.uc-muted { color: var(--text-3); }
.uc-foot {
  font-size: 22rpx;
  color: var(--text-3);
}
.pt {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-subtle);
  color: var(--text-3);
  font-weight: 500;
}
.pt-admin { color: var(--danger-dark); background: var(--danger-soft); }
.pt-teacher { color: var(--brand); background: var(--brand-soft); }
.pt-disabled { color: var(--danger-dark); background: var(--danger-soft); }

/* ===== 操作区 ===== */
.uc-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 28rpx 24rpx;
  border-top: 1rpx solid var(--border-light);
  padding-top: 18rpx;
}
.uc-act {
  font-size: 24rpx;
  color: var(--brand);
  padding: 8rpx 18rpx;
  border-radius: var(--radius-sm);
  background: var(--brand-soft);
}
.uc-act-warn {
  color: var(--warning-dark);
  background: var(--warning-soft);
}
.uc-act-ok {
  color: var(--success-dark);
  background: var(--success-soft);
}
.uc-act-danger {
  color: var(--danger-dark);
  background: var(--danger-soft);
}
.uc-protected {
  padding: 0 28rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

/* ===== 顶部加载 / 列表底部 ===== */
.top-loading { margin-bottom: 16rpx; }
.top-loading-bar {
  height: 4rpx;
  background: var(--brand);
  border-radius: 2rpx;
  margin-bottom: 8rpx;
  animation: shimmer 1s infinite;
}
.top-loading-text {
  font-size: 22rpx;
  color: var(--text-4);
  text-align: center;
  display: block;
}
@keyframes shimmer {
  0% { opacity: 0.5; }
  50% { opacity: 1; }
  100% { opacity: 0.5; }
}
.list-end {
  text-align: center;
  color: var(--text-4);
  font-size: 24rpx;
  padding: 20rpx 0 40rpx;
}

/* ===== 悬浮按钮 ===== */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 50;
  background: var(--brand);
  color: var(--bg-card);
  font-size: 28rpx;
  font-weight: 500;
  padding: 22rpx 32rpx;
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-md);
}

.sheet-scroll {
  flex: 1;
  padding: 24rpx 28rpx;
}
.sheet-form {
  padding-bottom: 24rpx;
}
.form-section {
  margin-bottom: 32rpx;
}
.form-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 16rpx;
}
.form-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 4rpx;
  margin-bottom: 20rpx;
  position: relative;
}
.form-row::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--border-light);
  transform: scaleY(0.5);
}
.form-row:last-child { margin-bottom: 0; }
.form-row:last-child::after { display: none; }
.form-row-focus { background: transparent; }
.form-row-focus::after { background: var(--brand); transform: scaleY(1); }
.form-row-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--text-2);
}
.form-row-label .req { color: var(--danger); margin-left: 4rpx; }
.form-row-input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--text-1);
  min-width: 0;
}
.form-row-input-focus { background: transparent; }
.form-row-picker { flex: 1; }
.form-row-picker-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}
.form-row-picker-text {
  font-size: 28rpx;
  color: var(--text-1);
}
.form-row-picker-text.ph { color: var(--text-3); }
.picker-arrow {
  width: 20rpx;
  height: 20rpx;
  border-top: 2rpx solid var(--text-4);
  border-right: 2rpx solid var(--text-4);
  transform: rotate(45deg);
  margin-right: 6rpx;
}
.form-row-static {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-3);
}

