/* 筛选栏：与教师管理/教师课时页一致 */
.filter-bar {
  display: flex;
  align-items: center;
  padding-bottom: 16rpx;
}
.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 36rpx;
  padding: 0 24rpx;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.search-icon {
  font-size: 28rpx;
  color: #1C82F5;
  margin-right: 12rpx;
}
.filter-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  background: transparent;
  font-size: 26rpx;
  color: #1a1a1a;
}
.filter-picker {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 72rpx;
  margin-left: 16rpx;
  padding: 0 24rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #555;
}
.filter-picker.active {
  color: #1C82F5;
  background: #E8F4FD;
  border-color: #1C82F5;
}
.filter-clear {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin-left: 16rpx;
  padding: 0 24rpx;
  border: 1rpx solid #1C82F5;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #1C82F5;
  background: #fff;
}

/* 局部刷新提示 */
.top-loading {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.top-loading-bar {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  border: 4rpx solid #e3e6ea;
  border-top-color: #1C82F5;
  border-radius: 50%;
  animation: tl-spin 0.7s linear infinite;
}
.top-loading-text {
  font-size: 24rpx;
  color: #8a8a8a;
}
@keyframes tl-spin {
  to { transform: rotate(360deg); }
}

/* 用户卡片 */
.user-card { padding: 24rpx 28rpx; }
.uc-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.uc-left { flex: 1; min-width: 0; }
.uc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.uc-sub {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-top: 10rpx;
  line-height: 1.4;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.uc-email {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 360rpx;
}
.uc-divider {
  color: #d1d5db;
  margin: 0 10rpx;
  transform: scaleY(0.8);
}
.uc-muted { color: #b0b0b0; }
.uc-foot {
  font-size: 22rpx;
  color: #a0a0a0;
  margin-top: 8rpx;
}
.uc-actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0f0f0;
}
.uc-act {
  font-size: 24rpx;
  color: #1C82F5;
  background: #e8f3fe;
  border: 1rpx solid #bfdbfe;
  border-radius: 24rpx;
  padding: 8rpx 26rpx;
  margin: 0 16rpx 16rpx 0;
}
.uc-act-warn { color: #ff6b1a; background: #fff0e8; border-color: #ffd3ba; }
.uc-act-ok { color: #10b981; background: #e7f8f2; border-color: #a7e8d0; }
.uc-act-danger { color: #e53e3e; background: #fdecec; border-color: #f7c5c5; }
.uc-act:active { opacity: 0.7; }
.uc-protected {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 22rpx;
  color: #b0b0b0;
}

/* 角色标签（复用 .pt 体系，颜色区分权限等级） */
.pt {
  display: inline-block;
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-left: 10rpx;
  font-weight: 400;
}
.pt-super { color: #b45309; background: #fef3c7; border: 1rpx solid #fde68a; }
.pt-admin { color: #1C82F5; background: #e8f3fe; border: 1rpx solid #bfdbfe; }
.pt-viewer { color: #64748b; background: #f1f5f9; border: 1rpx solid #e2e8f0; }
.pt-disabled { color: #b0b0b0; background: #f1f5f9; border: 1rpx solid #e2e8f0; }

/* 列表底部 */
.list-end {
  text-align: center;
  color: #b0b0b0;
  font-size: 24rpx;
  padding: 24rpx 0;
}

/* 悬浮新增按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  background: #1C82F5;
  color: #fff;
  font-size: 28rpx;
  padding: 22rpx 36rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(28, 130, 245, 0.35);
  z-index: 50;
}

/* 新增 / 编辑 弹层 */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  height: 88vh;
  max-height: 88vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 20rpx 48rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.sheet-header {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 18rpx;
}
.sheet-handle {
  width: 44rpx;
  height: 5rpx;
  background: #d1d5db;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: 0.6rpx;
}
.sheet-scroll {
  flex: 1;
  min-height: 0;
  margin: 0 -48rpx;
  padding: 0 48rpx;
}
.sheet-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}
.sheet-form { padding-bottom: 240rpx; }
.form-section { margin-bottom: 32rpx; }
.form-section-last { margin-bottom: 0; }
.form-section-title {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-bottom: 14rpx;
  padding-left: 4rpx;
  font-weight: 500;
  letter-spacing: 0.4rpx;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-row:last-child { border-bottom: none; }
.form-row-focus { border-bottom-color: #1C82F5; }
.form-row-label {
  width: 170rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  flex-shrink: 0;
  font-weight: 500;
}
.req { color: #f87171; margin-left: 4rpx; }
.form-row-input,
.form-row-picker {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #111827;
  text-align: right;
  height: 44rpx;
  line-height: 44rpx;
  background: transparent;
  padding: 0;
}
.form-row-static {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #8a8a8a;
  text-align: right;
}
.form-row-input-focus { color: #1C82F5; }
.form-row-picker {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.form-row-picker-inner {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.form-row-picker-text {
  font-size: 28rpx;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1;
}
.picker-arrow {
  width: 0;
  height: 0;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-top: 8rpx solid #c1c7ce;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.sheet-actions {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  padding-top: 20rpx;
  background: #fff;
}
.sheet-actions .sheet-btn:first-child {
  margin-right: 24rpx !important;
}
.sheet-actions::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 100%;
  height: 60rpx;
  background: linear-gradient(to top, rgba(255, 255, 255, 1), rgba(255, 255, 255, 0));
  pointer-events: none;
}
.sheet-btn {
  flex: 1;
  display: flex !important;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 !important;
  height: 90rpx;
  line-height: 1;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0.8rpx;
  border-radius: 18rpx;
  transition: all 0.12s ease;
}
.sheet-btn::after { border: none; }
.sheet-btn[disabled] { opacity: 0.55; }
.btn-ghost.sheet-btn {
  background: #f3f4f6;
  color: #4b5563;
}
.btn-ghost.sheet-btn:active { background: #e5e7eb; }
.btn-primary.sheet-btn {
  background: linear-gradient(135deg, #1C82F5 0%, #3b95f7 100%);
  box-shadow: 0 8rpx 24rpx rgba(28, 130, 245, 0.28);
}
.btn-primary.sheet-btn:active {
  box-shadow: 0 4rpx 14rpx rgba(28, 130, 245, 0.2);
  transform: translateY(1rpx);
}
.placeholder { color: #9ca3af; }
