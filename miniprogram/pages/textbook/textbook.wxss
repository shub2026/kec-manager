.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 0 8rpx;
}
.search-input {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.search-ico {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: #b0b0b0;
}
.search-field {
  flex: 1;
  font-size: 28rpx;
  height: 72rpx;
}
.search-clear {
  color: #b0b0b0;
  font-size: 28rpx;
  padding: 0 8rpx;
}
.search-btn {
  margin-left: 16rpx;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.count-line {
  font-size: 24rpx;
  color: #8a8a8a;
  padding: 8rpx 4rpx 16rpx;
}

.textbook-row {
  align-items: flex-start;
}
.tb-main {
  flex: 1;
  min-width: 0;
}
.tb-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tb-sub {
  margin-top: 8rpx;
}
.tb-pub {
  font-size: 24rpx;
  color: #07c160;
  margin-right: 16rpx;
}
.tb-cat {
  font-size: 22rpx;
  color: #fff;
  background: #c8c8c8;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}
.tb-isbn {
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 8rpx;
}
.tb-usage {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 16rpx;
}
.u-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #07c160;
}
.u-label {
  font-size: 20rpx;
  color: #8a8a8a;
}
