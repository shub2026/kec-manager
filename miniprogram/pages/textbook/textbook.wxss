.count-line {
  font-size: 24rpx;
  color: var(--text-3);
  margin: 4rpx 0 20rpx;
}

/* ===== 教材行 ===== */
.textbook-row {
  align-items: flex-start;
}
.tb-main {
  flex: 1;
  min-width: 0;
}
.tb-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 10rpx;
}
.tb-sub {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.tb-pub {
  font-size: 24rpx;
  color: var(--text-3);
}
.tb-cat {
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--bg-subtle);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
}
.tb-isbn {
  font-size: 22rpx;
  color: var(--text-4);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", monospace;
}
