.count-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-subtle);
  border-radius: var(--radius-md);
  padding: 14rpx 22rpx;
  font-size: 24rpx;
  color: var(--text-2);
  margin: 4rpx 0 20rpx;
}

/* ===== 教材行 ===== */
.textbook-row {
  align-items: flex-start;
}
.tb-main {
  flex: 1;
  min-width: 0;
}
.tb-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 10rpx;
}
.tb-sub {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.tb-pub {
  font-size: 24rpx;
  color: var(--text-3);
}
.tb-cat {
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--bg-subtle);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
}
.tb-isbn {
  font-size: 22rpx;
  color: var(--text-3);   /* P0：原 text-4 在白卡仅 2.56:1，提至 text-3 满足 4.5:1 */
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", monospace;
}
