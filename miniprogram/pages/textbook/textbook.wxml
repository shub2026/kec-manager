<view class="page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input">
      <text class="search-ico">🔍</text>
      <input
        class="search-field"
        placeholder="搜索书名 / ISBN"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
      />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="onClearKeyword">✕</text>
    </view>
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <view class="count-line" wx:if="{{!loading && !error}}">共 {{total}} 种教材</view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{error}}" class="errbox">{{error}}</view>

  <view wx:elif="{{list.length}}" class="list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="row textbook-row"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="tb-main">
        <view class="tb-title">{{item.title}}</view>
        <view class="tb-sub">
          <text class="tb-pub">{{item.publisher}}</text>
          <text class="tb-cat">{{item.category}}</text>
        </view>
        <view class="tb-isbn">ISBN：{{item.isbn}}</view>
      </view>
      <view class="tb-usage">
        <text class="u-num">{{item.usageCount}}</text>
        <text class="u-label">使用班</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view wx:else class="empty">未找到教材，换个关键词试试</view>

  <view wx:if="{{loadingMore}}" class="loading">加载更多…</view>
  <view wx:elif="{{finished && list.length}}" class="loading">— 已经到底了 —</view>
</view>
