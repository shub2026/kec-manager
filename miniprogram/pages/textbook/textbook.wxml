<view class="page">
  <view class="hero hero--plain">
    <view class="hero-card">
      <view class="hero-text">
        <view class="hero-title">教材查询</view>
        <view class="hero-subtitle">按需检索本学期教材与使用情况</view>
      </view>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input">
      <view class="search-ico"></view>
      <input
        class="search-field"
        placeholder="搜索书名 / ISBN"
        value="{{keyword}}"
        confirm-type="search"
        cursor-spacing="20"
        adjust-position
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
      />
      <view wx:if="{{keyword}}" class="search-clear clear-ico" hover-class="tap-hover" role="button" aria-label="清除关键词" bindtap="onClearKeyword"></view>
    </view>
    <view class="search-btn" hover-class="tap-hover" bindtap="onSearch">搜索</view>
  </view>

  <view class="count-line" wx:if="{{(!loading || refreshing) && !error}}">共 {{total}} 种教材</view>

  <view wx:if="{{refreshing}}" class="loading">刷新中…</view>
  <view wx:elif="{{loading && list.length === 0}}" class="loading">加载中…</view>
  <view wx:elif="{{error && list.length === 0}}" class="errbox">{{error}}</view>

  <view wx:if="{{list.length}}" class="list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="row textbook-row"
      hover-class="tap-hover"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="tb-main">
        <view class="tb-title">{{item.title}}</view>
        <view class="tb-sub">
          <text class="tb-pub">{{item.publisher}}</text>
          <text class="tb-cat">{{item.category}}</text>
        </view>
        <view class="tb-isbn">ISBN：{{item.isbn}}</view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view wx:else class="empty">未找到教材，换个关键词试试</view>

  <view wx:if="{{loadingMore}}" class="loading">加载更多…</view>
  <view wx:elif="{{finished && list.length}}" class="loading">— 已经到底了 —</view>
</view>
