<view class="page">
  <view class="hero hero--plain">
    <view class="hero-card">
      <view class="hero-text">
        <view class="hero-title">教师情况</view>
        <view class="hero-subtitle">本学期课时分布与工作量排行</view>
      </view>
      <view class="hero-decor"><view class="hero-ring"></view></view>
    </view>
  </view>

  <view wx:if="{{loading && !summary}}" class="loading">加载中…</view>
  <view wx:elif="{{error && !summary}}" class="errbox">{{error}}</view>

  <block wx:else>
    <!-- 教师情况（环形图示，与首页同款，置顶优先展示） -->
    <view class="card" wx:if="{{teacherLoadCard}}">
      <view wx:if="{{!teacherLoadCard.hasData}}" class="card-empty">暂无排课教师</view>
      <block wx:else>
        <view class="tl-main">
          <view class="tl-donut" style="background:{{teacherLoadCard.donut}}">
            <view class="tl-hole">
              <text class="tl-total">{{teacherLoadCard.total}}</text>
              <text class="tl-unit">人</text>
            </view>
          </view>
          <view class="tl-legend">
            <view wx:for="{{teacherLoadCard.entries}}" wx:key="label" class="tl-item">
              <text class="tl-dot" style="background:{{item.color}}"></text>
              <text class="tl-label">{{item.label}}</text>
              <text class="tl-count">{{item.count}} 人</text>
              <text class="tl-pct">{{item.pct}}%</text>
            </view>
          </view>
        </view>
        <view class="tl-metrics">
          <view class="tl-metric">
            <text class="tl-m-label">参与排课教师</text>
            <text class="tl-m-value">{{teacherLoadCard.assignedTeachers}}<text class="tl-m-sub">/{{teacherLoadCard.totalTeachers}} 在职</text></text>
          </view>
          <view class="tl-metric">
            <text class="tl-m-label">人均周课时</text>
            <text class="tl-m-value">{{teacherLoadCard.avgHours}}</text>
          </view>
        </view>
      </block>
    </view>

    <!-- 整体汇总 -->
    <view class="card" wx:if="{{summary}}">
      <view class="card-title">整体汇总</view>
      <view class="stat-grid">
        <view class="stat-cell"><view class="stat-inner">
          <view class="stat-num">{{summary.totalTeachers}}</view>
          <view class="stat-label">任课教师</view>
        </view></view>
        <view class="stat-cell"><view class="stat-inner">
          <view class="stat-num">{{summary.totalWeeklyHours}}</view>
          <view class="stat-label">总周课时</view>
        </view></view>
        <view class="stat-cell"><view class="stat-inner">
          <view class="stat-num">{{summary.totalClasses}}</view>
          <view class="stat-label">教学班数</view>
        </view></view>
        <view class="stat-cell"><view class="stat-inner">
          <view class="stat-num">{{summary.avgWeeklyHours}}</view>
          <view class="stat-label">人均周课时</view>
        </view></view>
      </view>
    </view>

    <!-- 各科教师分布 -->
    <view class="card">
      <view class="card-title">各科分布<text class="card-sub">（本学期任课）</text></view>
      <view class="college-tt" wx:for="{{subjectTeacherStat}}" wx:key="name">
        <view class="ct-head">
          <text class="ct-name">{{item.name}}</text>
          <text class="ct-total">共 {{item.total}} 人</text>
        </view>
        <view class="ct-bar">
          <view class="ct-seg seg-full" style="width:{{item.fullPct}}%"></view>
          <view class="ct-seg seg-part" style="width:{{item.partPct}}%"></view>
          <view class="ct-seg seg-ext" style="width:{{item.extPct}}%"></view>
          <view class="ct-seg seg-unk" wx:if="{{item.unkPct > 0}}" style="width:{{item.unkPct}}%"></view>
        </view>
        <view class="ct-legend">
          <text class="ct-tag tag-full">专 {{item.fullTime}}</text>
          <text class="ct-tag tag-part">兼 {{item.partTime}}</text>
          <text class="ct-tag tag-ext">外 {{item.external}}</text>
          <text class="ct-tag tag-unk" wx:if="{{item.unknown > 0}}">未分类 {{item.unknown}}</text>
        </view>
      </view>
      <view wx:if="{{!subjectTeacherStat.length}}" class="empty">暂无教师数据</view>
    </view>

  </block>
</view>
