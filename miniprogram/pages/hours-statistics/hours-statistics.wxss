/* ===== 各科分布副标题 ===== */
.card-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-4);
  margin-left: 8rpx;
}

/* ===== 各科分布 ===== */
.college-tt {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.college-tt:last-of-type {
  border-bottom: none;
}
.ct-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.ct-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-1);
  max-width: 460rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ct-total {
  font-size: 22rpx;
  color: var(--text-3);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.ct-bar {
  display: flex;
  gap: 4rpx;
  height: 12rpx;
  border-radius: 6rpx;
  overflow: hidden;
  background: #F4F5F8;
}
.ct-seg {
  height: 100%;
}
.seg-full { background: #10b981; } /* 专（与环形图 WEB 配色一致） */
.seg-part { background: #ff6b1a; }
.seg-ext  { background: #64748b; }
.seg-unk  { background: #c0c4cc; }

.ct-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}
.ct-tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  line-height: 1.4;
}
.tag-full { color: #047857; background: rgba(16, 185, 129, 0.20); } /* 深绿文字 + 绿浅底，对齐环形色 */
.tag-part { color: #c2410c; background: rgba(255, 107, 26, 0.20); }
.tag-ext  { color: #475569; background: rgba(100, 116, 139, 0.20); }
.tag-unk  { color: #4C515A; background: rgba(192, 196, 204, 0.7); }

/* ===== 顶部教师情况环形图示（与首页同款） ===== */
.card-empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
}
.tl-main {
  display: flex;
  align-items: center;
  gap: 36rpx;
  padding: 8rpx 0 4rpx;
}
.tl-donut {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.tl-hole {
  position: absolute;
  width: 128rpx;
  height: 128rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: var(--bg-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tl-total {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-1);
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}
.tl-unit {
  font-size: 22rpx;
  color: var(--text-3);
}
.tl-legend {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  min-width: 0;
}
.tl-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
}
.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.tl-label {
  color: var(--text-2);
  flex-shrink: 0;
}
.tl-count {
  color: var(--text-3);
  margin-left: auto;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}
.tl-pct {
  width: 76rpx;
  text-align: right;
  font-weight: 600;
  color: var(--text-1);
  margin-left: 14rpx;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}
.tl-metrics {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.tl-metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 20rpx 22rpx;
  background: var(--bg-subtle);
  border-radius: var(--radius-md);
}
.tl-m-label {
  font-size: 23rpx;
  color: var(--text-3);
}
.tl-m-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}
.tl-m-sub {
  font-size: 21rpx;
  font-weight: 400;
  color: var(--text-3);
  margin-left: 6rpx;
}
