/* ===== 各科分布 ===== */
.college-tt {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.college-tt:last-of-type {
  border-bottom: none;
}
.ct-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.ct-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-1);
  max-width: 460rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ct-total {
  font-size: 22rpx;
  color: var(--text-3);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.ct-bar {
  display: flex;
  gap: 4rpx;
  height: 12rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--bg-subtle);
}
.ct-seg {
  height: 100%;
}
.seg-full { background: var(--success); } /* 专（与环形图 WEB 配色一致） */
.seg-part { background: var(--warning); }
.seg-ext  { background: var(--text-3); }
.seg-unk  { background: var(--text-5); }

.ct-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}
.ct-tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  line-height: 1.4;
}
.tag-full { color: var(--success-dark); background: var(--success-soft); } /* 深绿文字 + 绿浅底，对齐环形色 */
.tag-part { color: var(--warning-dark); background: var(--warning-soft); }
.tag-ext  { color: var(--text-2); background: var(--bg-subtle); }
.tag-unk  { color: var(--text-2); background: var(--bg-hover); }

.card-empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
}

