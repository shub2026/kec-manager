/* ===== 教师构成副标题 ===== */
.card-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-4);
  margin-left: 8rpx;
}

/* ===== 教师构成 · 各科分布 ===== */
.tt-divider {
  display: flex;
  align-items: center;
  margin: 28rpx 0 20rpx;
}
.tt-divider-line {
  flex: 1;
  height: 1rpx;
  background: var(--border-light);
}
.tt-divider-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-3);
  margin: 0 20rpx;
  letter-spacing: 2rpx;
}

.college-tt {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.college-tt:last-of-type {
  border-bottom: none;
}
.ct-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.ct-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-1);
  max-width: 460rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ct-total {
  font-size: 22rpx;
  color: var(--text-3);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.ct-bar {
  display: flex;
  gap: 4rpx;
  height: 12rpx;
  border-radius: 6rpx;
  overflow: hidden;
  background: #F4F5F8;
}
.ct-seg {
  height: 100%;
}
.seg-full { background: #5FA0CC; }
.seg-part { background: #C0908B; }
.seg-ext  { background: #7DB888; }
.seg-unk  { background: #C9CED8; }

.ct-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}
.ct-tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  line-height: 1.4;
}
.tag-full { color: #1E5E85; background: rgba(95, 160, 204, 0.24); }
.tag-part { color: #7A4D48; background: rgba(192, 144, 139, 0.30); }
.tag-ext  { color: #2F5E3E; background: rgba(125, 184, 136, 0.28); }
.tag-unk  { color: #4C515A; background: rgba(201, 206, 216, 0.7); }
