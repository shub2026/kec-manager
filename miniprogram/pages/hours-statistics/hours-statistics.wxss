/* ===== 学院课时分布 ===== */
.dist-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.dist-row:last-child { border-bottom: none; }
.dist-name {
  width: 140rpx;
  font-size: 26rpx;
  color: var(--text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dist-bar {
  flex: 1;
  margin: 0 16rpx;
}
.dist-num {
  width: 80rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
}

/* ===== Top 教师 ===== */
.top-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.top-row:last-child { border-bottom: none; }
.top-rank {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--bg-subtle);
  border: 1rpx solid var(--border);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-2);
  flex-shrink: 0;
  margin-right: 18rpx;
}
.top-row:nth-child(1) .top-rank {
  background: var(--brand-soft);
  border-color: var(--brand-border);
  color: var(--brand);
}
.top-row:nth-child(2) .top-rank {
  background: var(--bg-subtle);
  border-color: var(--border);
  color: var(--text-1);
}
.top-row:nth-child(3) .top-rank {
  background: var(--bg-subtle);
  border-color: var(--border);
  color: var(--text-1);
}
.top-main {
  flex: 1;
  min-width: 0;
}
.top-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.top-college {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
}
.top-hours {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.th-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  line-height: 1.2;
}
.th-label {
  font-size: 20rpx;
  color: var(--text-4);
}
