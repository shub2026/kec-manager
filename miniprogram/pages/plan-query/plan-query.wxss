.count-line {
  font-size: 24rpx;
  color: var(--text-3);
  margin: 4rpx 0 20rpx;
}

/* ===== 方案卡片 ===== */
.plan-card {
  position: relative;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  margin-bottom: 20rpx;
  overflow: hidden;
}
.pc-top {
  display: flex;
  align-items: stretch;
}
.pc-accent {
  display: none;
}

.pc-body {
  flex: 1;
  min-width: 0;
  padding: 28rpx;
}
.pc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.pc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pc-status {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}
.pc-status.pc-active { color: var(--success-dark); background: var(--success-soft); }
.pc-status.pc-draft { color: var(--warning-dark); background: var(--warning-soft); }
.pc-status.pc-archived { color: var(--text-3); background: var(--bg-subtle); }

.pc-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.pc-tag {
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--bg-subtle);
  padding: 3rpx 12rpx;
  border-radius: var(--radius-sm);
}
.pc-apply {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 16rpx;
}
.pc-stats {
  display: flex;
  gap: 24rpx;
  margin-bottom: 18rpx;
}
.pc-stat {
  font-size: 24rpx;
  color: var(--text-3);
}
.pc-num {
  color: var(--text-1);
  font-weight: 700;
  font-size: 28rpx;
  margin-right: 4rpx;
}
.pc-expand-hint {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-light);
  font-size: 24rpx;
  color: var(--brand);
}
.pc-expand-icon {
  margin-right: 8rpx;
  font-size: 20rpx;
}

/* ===== 展开明细 ===== */
.pc-detail {
  padding: 0 28rpx 28rpx;
  border-top: 1rpx solid var(--border-light);
}
.detail-loading {
  text-align: center;
  padding: 40rpx 0;
  color: var(--text-4);
  font-size: 26rpx;
}

.ov-bar {
  display: flex;
  margin: 24rpx 0;
  background: var(--bg-subtle);
  border-radius: var(--radius-md);
  padding: 20rpx 0;
}
.ov-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid var(--border-light);
}
.ov-item:last-child { border-right: none; }
.ov-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  line-height: 1.2;
}
.ov-lbl {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

/* 图例 */
.dt-legend {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 14rpx 18rpx;
  background: var(--bg-subtle);
  border-radius: var(--radius-md);
}
.lg-t {
  font-size: 24rpx;
  color: var(--text-3);
}
.lg-items {
  display: flex;
  gap: 16rpx;
}
.lg-i {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-3);
}
.lg-d {
  width: 22rpx;
  height: 22rpx;
  border-radius: 5rpx;
  margin-right: 6rpx;
}
.lg-d0 { background: var(--border); }
.lg-d1 { background: var(--brand-border); }
.lg-d2 { background: var(--brand-light); }
.lg-d3 { background: var(--brand); }

/* 分组 */
.grp {
  margin-bottom: 24rpx;
}
.grp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  border-radius: var(--radius-md);
  margin-bottom: 14rpx;
}
.g-public { background: var(--brand-soft); }
.g-professional { background: var(--success-soft); }
.grp-label {
  font-size: 26rpx;
  font-weight: 600;
}
.g-public .grp-label { color: var(--brand-dark); }
.g-professional .grp-label { color: var(--success-dark); }
.grp-meta {
  font-size: 22rpx;
  color: var(--text-3);
}

/* 课程卡片 */
.crs-list {
  background: var(--bg-page);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.crs {
  padding: 20rpx 22rpx;
}
.crs + .crs {
  border-top: 1rpx solid var(--border);
}
.crs-off { opacity: 0.7; }
.crs-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
}
.crs-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.name-off { color: var(--text-4); }
.crs-type {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-card);
  color: var(--text-3);
}
.t-public { color: var(--brand); background: var(--brand-soft); }
.t-professional { color: var(--success-dark); background: var(--success-soft); }
.crs-stop {
  font-size: 20rpx;
  color: var(--danger-dark);
  background: var(--danger-soft);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
}
.crs-total {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 600;
}

/* 学期明细 */
.crs-sems {
  background: var(--bg-card);
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.sem-row {
  padding: 16rpx 18rpx;
}
.sem-row + .sem-row {
  border-top: 1rpx solid var(--border-light);
}
.sem-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.sem-idx {
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 500;
}
.sem-hours {
  font-size: 22rpx;
  padding: 3rpx 10rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}
.h-zero { color: var(--text-4); background: var(--bg-subtle); }
.h-low { color: var(--brand-dark); background: var(--brand-soft); }
.h-mid { color: var(--bg-card); background: var(--brand-light); }
.h-high { color: var(--bg-card); background: var(--brand); }
.sem-weeks, .sem-hours-total {
  font-size: 22rpx;
  color: var(--text-3);
}
.sem-books {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.bk-line {
  display: flex;
  align-items: flex-start;
  font-size: 22rpx;
}
.bk-dot {
  margin-right: 8rpx;
  font-size: 18rpx;
  line-height: 1.5;
  flex-shrink: 0;
}
.bk-req { color: var(--brand); }
.bk-opt { color: var(--text-4); }
.bk-title {
  color: var(--text-2);
  flex: 1;
  line-height: 1.5;
}
.bk-off { color: var(--text-4); text-decoration: line-through; }
.bk-none {
  font-size: 22rpx;
  color: var(--text-4);
}
