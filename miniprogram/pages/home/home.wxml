<view class="page">
  <view class="hero">
    <view class="hero-card">
      <view class="hero-text">
        <view class="hero-title">首页概览</view>
        <view class="hero-subtitle">实时掌握本学期教学运行数据</view>
        <view class="hero-badge">
          <text class="hero-badge-text">当前学期：{{semester || '未设置'}}</text>
        </view>
      </view>
      <view class="hero-decor">
        <image class="hero-logo" src="/assets/logo.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 快捷查询入口：开课查询 + 教材查询（不在底部工具栏，改为首页卡片入口） -->
  <view class="card entry-section">
    <view class="card-title">快捷查询</view>
    <view class="entry-grid">
      <view class="entry-card" hover-class="entry-card-hover" bindtap="goCourseQuery">
        <view class="ei ei-course"></view>
        <view class="entry-body">
          <view class="entry-title">开课查询</view>
          <view class="entry-sub">按年级查开课与教材</view>
        </view>
        <text class="entry-arrow">›</text>
      </view>
      <view class="entry-card" hover-class="entry-card-hover" bindtap="goTextbook">
        <view class="ei ei-textbook"></view>
        <view class="entry-body">
          <view class="entry-title">教材查询</view>
          <view class="entry-sub">搜索教材与选用详情</view>
        </view>
        <text class="entry-arrow">›</text>
      </view>
      <view class="entry-card" hover-class="entry-card-hover" bindtap="goPlanQuery">
        <view class="ei ei-plan"></view>
        <view class="entry-body">
          <view class="entry-title">方案查询</view>
          <view class="entry-sub">培养方案与课程安排</view>
        </view>
        <text class="entry-arrow">›</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading && !stats}}" class="loading">加载中…</view>
  <view wx:elif="{{error && !stats}}" class="errbox">{{error}}</view>

  <block wx:else>
    <view wx:if="{{refreshing}}" class="loading">刷新中…</view>

    <!-- 本学期概览 -->
    <view class="card">
      <view class="card-title">本学期概览</view>
      <view class="stat-grid">
        <view class="stat-cell"><view class="stat-inner">
          <view class="stat-ico si-students"></view>
          <view class="stat-data">
            <view class="stat-num">{{stats.totalStudents}}</view>
            <view class="stat-label">在读学生</view>
          </view>
        </view></view>
        <view class="stat-cell"><view class="stat-inner">
          <view class="stat-ico si-classes"></view>
          <view class="stat-data">
            <view class="stat-num">{{stats.classes}}</view>
            <view class="stat-label">在读班级</view>
          </view>
        </view></view>
        <view class="stat-cell"><view class="stat-inner">
          <view class="stat-ico si-courses"></view>
          <view class="stat-data">
            <view class="stat-num">{{stats.courses}}</view>
            <view class="stat-label">开设课程</view>
          </view>
        </view></view>
        <view class="stat-cell"><view class="stat-inner">
          <view class="stat-ico si-teachers"></view>
          <view class="stat-data">
            <view class="stat-num">{{stats.teachingTeachers}}</view>
            <view class="stat-label">任课教师</view>
          </view>
        </view></view>
        <view class="stat-cell"><view class="stat-inner">
          <view class="stat-ico si-majors"></view>
          <view class="stat-data">
            <view class="stat-num">{{stats.majors}}</view>
            <view class="stat-label">专业数</view>
          </view>
        </view></view>
        <view class="stat-cell"><view class="stat-inner">
          <view class="stat-ico si-textbooks"></view>
          <view class="stat-data">
            <view class="stat-num">{{stats.textbooks}}</view>
            <view class="stat-label">教材数</view>
          </view>
        </view></view>
      </view>
      <view class="hours-row">
        <view class="hours-item">
          <text class="h-num">{{stats.assignedWeeklyHours}}</text>
          <text class="h-label">已排周课时</text>
        </view>
        <view class="hours-item">
          <text class="h-num">{{stats.plannedWeeklyHours}}</text>
          <text class="h-label">计划周课时</text>
        </view>
      </view>
    </view>

    <!-- 排课进度（复用 web 端 CourseProgressChart） -->
    <view class="card">
      <view class="card-title">排课进度
        <text class="more" bindtap="goStatistics">课时统计 ›</text>
      </view>

      <view wx:if="{{insights.progress.total === 0}}" class="card-empty">暂无排课数据</view>

      <block wx:else>
        <view class="progress-summary">
          <text class="ps-percent">{{insights.progress.rate}}<text class="ps-sign">%</text></text>
          <text class="ps-label">已排课占比</text>
        </view>

        <view class="progress-track">
          <view class="progress-filled" style="width:{{insights.progress.rate}}%"></view>
        </view>

        <view class="progress-legend">
          <view class="pl-item">
            <text class="pl-dot pl-dot-filled"></text>
            <text class="pl-text">已排课 <text class="pl-num">{{insights.progress.assigned}}</text> 门</text>
          </view>
          <view class="pl-item">
            <text class="pl-dot pl-dot-remaining"></text>
            <text class="pl-text">剩余 <text class="pl-num">{{insights.progress.remaining}}</text> 门</text>
          </view>
        </view>

        <view class="hours-summary">
          <view class="hs-tag hs-filled">
            <text class="hs-text">已排 <text class="hs-num">{{insights.progress.assignedHours}}</text> 课时</text>
          </view>
          <view class="hs-tag hs-remaining">
            <text class="hs-text">剩余 <text class="hs-num">{{insights.progress.remainingHours}}</text> 课时</text>
          </view>
        </view>

        <view wx:if="{{insights.progress.complete}}" class="complete-hint">全部课程已排课完成</view>
      </block>
    </view>

    <!-- 异常提醒（复用 web 端 AlertCard） -->
    <view class="card">
      <view class="card-title">异常提醒
        <text wx:if="{{insights.alerts.hasAlert}}" class="alert-badge">{{insights.alerts.unassigned.length + insights.alerts.overloaded.length}}</text>
      </view>

      <view wx:if="{{!insights.alerts.hasAlert}}" class="alert-empty">
        <text class="ae-check">✓</text>
        <text class="ae-text">暂无异常，一切正常</text>
      </view>

      <block wx:else>
        <view wx:if="{{insights.alerts.unassigned.length}}" class="alert-group">
          <view class="ag-title"><text class="ag-dot ag-warn"></text><text>{{insights.alerts.unassigned.length}} 门课程未排课</text></view>
          <view wx:for="{{insights.alerts.unassigned}}" wx:key="id" class="ai-item ai-warn">{{item.name}}</view>
          <view wx:if="{{insights.alerts.unassignedMore}}" class="ai-more">+{{insights.alerts.unassignedMore}} 门未显示</view>
        </view>

        <view wx:if="{{insights.alerts.overloaded.length}}" class="alert-group">
          <view class="ag-title"><text class="ag-dot ag-danger"></text><text>{{insights.alerts.overloaded.length}} 位教师课时超限</text></view>
          <view wx:for="{{insights.alerts.overloaded}}" wx:key="id" class="ai-item ai-danger">
            <text class="ai-name">{{item.name}}</text>
            <text class="ai-detail">{{item.hours}}/{{item.limit}} 课时</text>
          </view>
          <view wx:if="{{insights.alerts.overloadedMore}}" class="ai-more">+{{insights.alerts.overloadedMore}} 位未显示</view>
        </view>
      </block>
    </view>

    <!-- 课时概览（复用 web 端 CourseStatsCard） -->
    <view class="card">
      <view class="card-title">课时概览</view>

      <view wx:if="{{insights.courseStats.length === 0}}" class="card-empty">暂无排课数据</view>

      <block wx:else>
        <view wx:for="{{insights.courseStats}}" wx:key="id" class="cs-row">
          <view class="cs-name">
            <text class="cs-dot" style="background:{{item._color}}"></text>
            <text class="cs-name-text">{{item.name}}</text>
          </view>
          <view class="cs-hours">
            <view class="cs-bar-wrap">
              <view class="cs-bar" style="width:{{item._pct}}%;background:{{item._color}}"></view>
            </view>
            <text class="cs-value">{{item.totalHours}}</text>
          </view>
          <view class="cs-meta">
            <text class="cs-meta-num">{{item.classCount}}班</text>
            <text class="cs-meta-num">{{item.teacherCount}}人</text>
          </view>
        </view>

        <view class="cs-footer">
          <text>共 {{insights.courseStatsCount}} 门课程</text>
          <text>合计 <text class="cs-total">{{insights.courseStatsTotal}}</text> 课时</text>
        </view>
      </block>
    </view>

    <!-- 学院课时分布 -->
    <view class="card">
      <view class="card-title">学院课时分布</view>
      <view wx:for="{{insights.distribution}}" wx:key="name" class="dist-row">
        <text class="dist-name">{{item.name}}</text>
        <view class="bar dist-bar"><view class="bar-in" style="width:{{item._pct}}%"></view></view>
        <text class="dist-num">{{item.hours}}</text>
      </view>
      <view wx:if="{{!insights.distribution.length}}" class="empty">暂无分布数据</view>
    </view>

  </block>
</view>
