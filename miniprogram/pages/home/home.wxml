<view class="page">
  <view class="hero">
    <view class="hero-card">
      <view class="hero-text">
        <view class="hero-title">KEC课程管理平台</view>
        <view class="hero-subtitle is-org"><text class="org-ico"></text><text class="org-text">{{orgName || '欢迎回来'}}</text></view>
        <view class="hero-badge">
          <text class="hero-badge-text">当前学期：{{semester || '未设置'}}</text>
        </view>
      </view>
      <view class="hero-decor">
        <image class="hero-logo" src="/assets/logo.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 快捷查询入口：开课查询 + 教材查询（不在底部工具栏，改为首页卡片入口） -->
  <view class="card entry-section">
    <view class="card-title">快捷查询</view>
    <view class="entry-grid">
      <view class="entry-card" hover-class="entry-card-hover" bindtap="goCourseQuery">
        <view class="ei ei-course"></view>
        <view class="entry-body">
          <view class="entry-title">开课查询</view>
          <view class="entry-sub">按年级查开课与教材</view>
        </view>
        <text class="entry-arrow">›</text>
      </view>
      <view class="entry-card" hover-class="entry-card-hover" bindtap="goTextbook">
        <view class="ei ei-textbook"></view>
        <view class="entry-body">
          <view class="entry-title">教材查询</view>
          <view class="entry-sub">搜索教材与选用详情</view>
        </view>
        <text class="entry-arrow">›</text>
      </view>
      <view class="entry-card" hover-class="entry-card-hover" bindtap="goStatistics">
        <view class="ei ei-teacher"></view>
        <view class="entry-body">
          <view class="entry-title">教师情况</view>
          <view class="entry-sub">教师工作量与构成</view>
        </view>
        <text class="entry-arrow">›</text>
      </view>
      <view class="entry-card" hover-class="entry-card-hover" bindtap="goPlanQuery">
        <view class="ei ei-plan"></view>
        <view class="entry-body">
          <view class="entry-title">方案查询</view>
          <view class="entry-sub">培养方案与课程安排</view>
        </view>
        <text class="entry-arrow">›</text>
      </view>
      <view wx:if="{{isAdmin}}" class="entry-card entry-card--admin" hover-class="entry-card-hover" bindtap="goTeacherAdmin">
        <view class="ei ei-mgr"></view>
        <view class="entry-body">
          <view class="entry-title">教师管理</view>
          <view class="entry-sub">新增与维护教师档案</view>
        </view>
        <text class="entry-tag">管理</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading && !stats}}" class="loading">加载中…</view>
  <view wx:elif="{{error && !stats}}" class="errbox">{{error}}</view>

  <block wx:else>
    <view wx:if="{{refreshing}}" class="loading">刷新中…</view>

    <!-- 本学期概览 -->
    <view class="card">
      <view class="card-title">本学期概览</view>
      <view class="ov-grid">
        <view class="ov-cell">
          <view class="ov-num">{{stats.totalWeeklyHours}}</view>
          <view class="ov-label"><text class="ov-ico ov-ico-clock"></text>总周课时</view>
        </view>
        <view class="ov-cell">
          <view class="ov-num">{{stats.teachingTeachers}}</view>
          <view class="ov-label"><text class="ov-ico ov-ico-user"></text>参与教师</view>
        </view>
        <view class="ov-cell">
          <view class="ov-num">{{stats.courses}}</view>
          <view class="ov-label"><text class="ov-ico ov-ico-book"></text>课程数量</view>
        </view>
        <view class="ov-cell">
          <view class="ov-num">{{stats.classes}}</view>
          <view class="ov-label"><text class="ov-ico ov-ico-grid"></text>班级数量</view>
        </view>
        <view class="ov-cell">
          <view class="ov-num">{{stats.totalStudents}}</view>
          <view class="ov-label"><text class="ov-ico ov-ico-users"></text>在读学生</view>
        </view>
        <view class="ov-cell">
          <view class="ov-num">{{stats.plans}}</view>
          <view class="ov-label"><text class="ov-ico ov-ico-doc"></text>培养方案</view>
        </view>
      </view>
    </view>

    <!-- 排课进度（复用 web 端 CourseProgressChart） -->
    <view class="card">
      <view class="card-title">排课进度</view>

      <view wx:if="{{insights.progress.total === 0}}" class="card-empty">暂无排课数据</view>

      <block wx:else>
        <view class="progress-summary">
          <text class="ps-percent">{{insights.progress.rate}}<text class="ps-sign">%</text></text>
          <text class="ps-label">课时完成率</text>
        </view>

        <view class="progress-track">
          <view class="progress-filled" style="width:{{insights.progress.rate}}%"></view>
        </view>

        <view class="progress-legend">
          <view class="pl-item">
            <text class="pl-dot pl-dot-filled"></text>
            <text class="pl-text">已排课 <text class="pl-num">{{insights.progress.assigned}}</text> 门</text>
          </view>
          <view class="pl-item">
            <text class="pl-dot pl-dot-remaining"></text>
            <text class="pl-text">剩余 <text class="pl-num">{{insights.progress.remaining}}</text> 门</text>
          </view>
        </view>

        <view class="hours-summary">
          <view class="hs-tag hs-filled">
            <text class="hs-text">已排 <text class="hs-num">{{insights.progress.assignedHours}}</text> 课时</text>
          </view>
          <view class="hs-tag hs-remaining">
            <text class="hs-text">剩余 <text class="hs-num">{{insights.progress.remainingHours}}</text> 课时</text>
          </view>
        </view>

        <view wx:if="{{insights.progress.complete}}" class="complete-hint">全部课程已排课完成</view>
      </block>
    </view>

    <!-- 教师情况（对照 web 端 TeacherLoadCard，环形图示） -->
    <view class="card">
      <view class="card-title">教师情况
        <text class="more" hover-class="tap-hover" bindtap="goStatistics">更多 ›</text>
      </view>

      <view wx:if="{{!insights.teacherLoad.hasData}}" class="card-empty">暂无排课教师</view>

      <block wx:else>
        <view class="tl-main">
          <view class="tl-donut" style="background:{{insights.teacherLoad.donut}}">
            <view class="tl-hole">
              <text class="tl-total">{{insights.teacherLoad.total}}</text>
              <text class="tl-unit">人</text>
            </view>
          </view>
          <view class="tl-legend">
            <view wx:for="{{insights.teacherLoad.entries}}" wx:key="label" class="tl-item">
              <text class="tl-dot" style="background:{{item.color}}"></text>
              <text class="tl-label">{{item.label}}</text>
              <text class="tl-count">{{item.count}} 人</text>
              <text class="tl-pct">{{item.pct}}%</text>
            </view>
          </view>
        </view>

        <view class="tl-metrics">
          <view class="tl-metric">
            <text class="tl-m-label">参与排课教师</text>
            <text class="tl-m-value">{{insights.teacherLoad.assignedTeachers}}<text class="tl-m-sub">/{{insights.teacherLoad.totalTeachers}} 在职</text></text>
          </view>
          <view class="tl-metric">
            <text class="tl-m-label">人均周课时</text>
            <text class="tl-m-value">{{insights.teacherLoad.avgHours}}</text>
          </view>
        </view>
      </block>
    </view>

    <!-- 课时概览（复用 web 端 CourseStatsCard） -->
    <view class="card">
      <view class="card-title">课时概览</view>

      <view wx:if="{{insights.courseStats.length === 0}}" class="card-empty">暂无课程数据</view>

      <block wx:else>
        <view wx:for="{{insights.courseStats}}" wx:key="id" class="cs-row">
          <view class="cs-name">
            <text class="cs-dot" style="background:{{item._color}}"></text>
            <text class="cs-name-text">{{item.name}}</text>
          </view>
          <view class="cs-hours">
            <view class="cs-bar-wrap">
              <view class="cs-bar" style="width:{{item._pct}}%;background:{{item._color}}"></view>
            </view>
            <text class="cs-value">{{item.totalHours}}</text>
            <text class="cs-delta cs-delta-{{item._deltaClass}}">{{item._deltaText}}</text>
          </view>
          <view class="cs-meta">
            <text class="cs-meta-num">{{item.classCount}}班</text>
            <text class="cs-meta-num">{{item.teacherCount}}人</text>
          </view>
        </view>

        <view class="cs-footer">
          <text>共 {{insights.courseStatsCount}} 门课程</text>
          <text>合计 <text class="cs-total">{{insights.courseStatsTotal}}</text> 课时</text>
        </view>
      </block>
    </view>

    <!-- 学院课时分布 -->
    <view class="card">
      <view class="card-title">学院课时分布</view>
      <view wx:for="{{insights.distribution}}" wx:key="name" class="dist-row">
        <text class="dist-name">{{item.name}}</text>
        <view class="bar dist-bar"><view class="bar-in" style="width:{{item._pct}}%"></view></view>
        <text class="dist-num">{{item.hours}}</text>
      </view>
      <view wx:if="{{!insights.distribution.length}}" class="empty">暂无分布数据</view>
    </view>

  </block>
</view>
