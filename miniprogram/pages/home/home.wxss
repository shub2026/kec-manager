.hero {
  padding: 32rpx 32rpx 8rpx;
}
.hero-term {
  font-size: 24rpx;
  color: #07c160;
  margin-bottom: 8rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.hours-row {
  display: flex;
  margin-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}
.hours-item {
  flex: 1;
  text-align: center;
}
.hours-item + .hours-item {
  border-left: 1rpx solid #f0f0f0;
}
.h-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #07c160;
}
.h-label {
  font-size: 24rpx;
  color: #8a8a8a;
}

.bar {
  height: 16rpx;
  background: #eef0f2;
  border-radius: 8rpx;
  overflow: hidden;
}
.bar-in {
  height: 100%;
  background: #07c160;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}
.completion-text {
  font-size: 26rpx;
  color: #8a8a8a;
  margin-top: 16rpx;
}

.alert-row {
  display: flex;
  margin-top: 20rpx;
}
.alert-item {
  flex: 1;
  background: #fdf3e3;
  border-radius: 12rpx;
  padding: 16rpx;
  text-align: center;
  margin-right: 16rpx;
}
.alert-item:last-child {
  margin-right: 0;
}
.alert-item.empty-alert {
  background: #e8f8ef;
}
.a-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}
.a-num.warn {
  color: #e08a00;
}
.a-num.ok {
  color: #07c160;
}
.a-label {
  font-size: 22rpx;
  color: #8a8a8a;
}

.dist-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.dist-name {
  width: 160rpx;
  font-size: 26rpx;
  color: #1a1a1a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dist-bar {
  flex: 1;
  margin: 0 16rpx;
}
.dist-num {
  width: 80rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: #07c160;
}

.entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 4rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
}
.entry:last-child {
  border-bottom: none;
}
.entry .arrow {
  color: #c8c8c8;
  font-size: 36rpx;
}
