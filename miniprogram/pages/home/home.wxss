/* ===== 本学期概览：已排/计划周课时 ===== */
.hours-row {
  display: flex;
  margin-top: 0;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-light);
}
.hours-item {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
}
.hours-item + .hours-item {
  border-left: 1rpx solid var(--border-light);
}
.h-num {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.2;
  margin-bottom: 2rpx;
}
.h-label {
  font-size: 23rpx;
  color: var(--text-4);
}

/* ===== 排课进度 ===== */
.card-empty {
  text-align: center;
  color: var(--text-4);
  padding: 48rpx 0;
  font-size: 26rpx;
}
.progress-summary {
  text-align: center;
  padding: 8rpx 0 4rpx;
}
.ps-percent {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--text-1);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -2rpx;
}
.ps-sign {
  font-size: 32rpx;
  font-weight: 600;
  margin-left: 4rpx;
  color: var(--text-3);
}
.ps-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}
.progress-track {
  height: 14rpx;
  background: var(--border-light);
  border-radius: 7rpx;
  overflow: hidden;
  margin-top: 24rpx;
}
.progress-filled {
  height: 100%;
  background: var(--brand);
  border-radius: 7rpx;
  transition: width 0.3s ease;
}
.progress-legend {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.pl-item {
  display: flex;
  align-items: center;
}
.pl-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.pl-dot-filled { background: var(--brand); }
.pl-dot-remaining { background: var(--text-5); }
.pl-num {
  font-weight: 700;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
}
.hours-summary {
  display: flex;
  margin-top: 24rpx;
  gap: 16rpx;
}
.hs-tag {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 12rpx;
  border-radius: var(--radius-md);
  font-size: 24rpx;
  border: 1rpx solid var(--border);
  background: var(--bg-subtle);
  color: var(--text-2);
}
.hs-num {
  font-weight: 700;
  margin: 0 4rpx;
  font-variant-numeric: tabular-nums;
}
.complete-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 18rpx;
  background: var(--success-soft);
  border: 1rpx solid var(--success-border);
  border-radius: var(--radius-md);
  font-size: 24rpx;
  color: var(--success);
  font-weight: 500;
}

/* ===== 异常提醒 ===== */
.alert-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: var(--warning);
  color: var(--bg-card);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 36rpx;
  text-align: center;
}
.alert-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  color: var(--text-3);
  font-size: 26rpx;
}
.ae-check {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--success-soft);
  color: var(--success);
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.alert-group { margin-bottom: 24rpx; }
.alert-group:last-child { margin-bottom: 0; }
.ag-title {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 16rpx;
}
.ag-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.ag-warn { background: var(--warning); }
.ag-danger { background: var(--danger); }
.ai-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-md);
  font-size: 26rpx;
  margin-bottom: 12rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-left: 5rpx solid var(--text-5);
}
.ai-item:last-child { margin-bottom: 0; }
.ai-warn { border-left-color: var(--warning); }
.ai-danger { border-left-color: var(--danger); }
.ai-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ai-detail {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-weight: 600;
  color: var(--danger);
  font-variant-numeric: tabular-nums;
}
.ai-more {
  font-size: 22rpx;
  color: var(--text-3);
  text-align: right;
}

/* ===== 课时概览 ===== */
.cs-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.cs-row:last-child { border-bottom: none; }
.cs-name {
  display: flex;
  align-items: center;
  width: 150rpx;
  flex-shrink: 0;
  min-width: 0;
}
.cs-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.cs-name-text {
  font-size: 26rpx;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}
.cs-hours {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
  margin: 0 16rpx;
}
.cs-bar-wrap {
  flex: 1;
  height: 14rpx;
  background: var(--border-light);
  border-radius: 7rpx;
  overflow: hidden;
  min-width: 0;
}
.cs-bar {
  height: 100%;
  border-radius: 7rpx;
}
.cs-value {
  width: 64rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
  text-align: right;
  font-variant-numeric: tabular-nums;
  margin-left: 12rpx;
}
.cs-meta {
  width: 134rpx;
  flex-shrink: 0;
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  gap: 6rpx;
}
.cs-meta-num {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-4);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.cs-meta-num + .cs-meta-num { margin-left: 0; }
.cs-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-light);
  font-size: 23rpx;
  color: var(--text-4);
}
.cs-total {
  color: var(--text-1);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* ===== 学院课时分布 ===== */
.dist-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.dist-row:last-child { border-bottom: none; }
.dist-name {
  width: 150rpx;
  font-size: 26rpx;
  color: var(--text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dist-bar {
  flex: 1;
  margin: 0 16rpx;
}
.dist-num {
  width: 80rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
}

/* ===== 快捷查询入口 ===== */
.entry-section {
  margin-bottom: 24rpx;
}
.entry-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.entry-card {
  flex: 1;
  min-width: 220rpx;
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 26rpx 22rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow-sm);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.entry-card-hover {
  background: var(--bg-subtle);
  transform: translateY(-2rpx);
  box-shadow: var(--shadow-md);
}
.entry-body {
  flex: 1;
  min-width: 0;
}
.entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}
.entry-sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.entry-arrow {
  color: var(--text-5);
  font-size: 40rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}
