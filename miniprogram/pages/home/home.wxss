.hours-row {
  display: flex;
  margin-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}
.hours-item {
  flex: 1;
  text-align: center;
}
.hours-item + .hours-item {
  border-left: 1rpx solid #f0f0f0;
}
.h-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1C82F5;
}
.h-label {
  font-size: 24rpx;
  color: #8a8a8a;
}

.bar {
  height: 16rpx;
  background: #eef0f2;
  border-radius: 8rpx;
  overflow: hidden;
}
.bar-in {
  height: 100%;
  background: #1C82F5;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}
.completion-text {
  font-size: 26rpx;
  color: #8a8a8a;
  margin-top: 16rpx;
}

.alert-row {
  display: flex;
  margin-top: 20rpx;
}
.alert-item {
  flex: 1;
  background: #fff0e8;
  border: 1rpx solid #ffd3ba;
  border-radius: 12rpx;
  padding: 16rpx;
  text-align: center;
  margin-right: 16rpx;
}
.alert-item:last-child {
  margin-right: 0;
}
.alert-item.danger-bg {
  background: #fee2e2;
  border-color: #fecaca;
}
.alert-item.ok-bg {
  background: #e7f8f2;
  border-color: #b7ead9;
}
.a-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}
.a-num.warn {
  color: #ff6b1a;
}
.a-num.danger {
  color: #dc2626;
}
.a-num.ok {
  color: #10b981;
}
.a-label {
  font-size: 22rpx;
  color: #8a8a8a;
}

.dist-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.dist-name {
  width: 160rpx;
  font-size: 26rpx;
  color: #1a1a1a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dist-bar {
  flex: 1;
  margin: 0 16rpx;
}
.dist-num {
  width: 80rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: #1C82F5;
}

