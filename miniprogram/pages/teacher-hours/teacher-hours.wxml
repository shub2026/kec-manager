<view class="page">
  <view class="hero hero--plain">
    <view class="hero-card">
      <view class="hero-text">
        <view class="hero-title">教师课时</view>
        <view class="hero-subtitle">查看教师周课时与任教明细</view>
      </view>
      <view class="hero-decor"><view class="hero-ring"></view></view>
    </view>
  </view>

  <view wx:if="{{loading && teachers.length === 0}}" class="loading">加载中…</view>
  <view wx:elif="{{error && teachers.length === 0}}" class="errbox">{{error}}</view>

  <block wx:else>
    <view class="filter-bar">
      <view class="search-box">
        <view class="search-icon"></view>
        <input class="filter-input" value="{{filterName}}" placeholder="搜索姓名" placeholder-class="placeholder" confirm-type="search" cursor-spacing="20" adjust-position bindinput="onNameInput" bindconfirm="onNameInput" />
      </view>
      <picker mode="selector" range="{{subjectOptions}}" bindchange="onSubjectChange">
        <view class="filter-picker {{filterSubject ? 'active' : ''}}">
          {{filterSubject || '选择科目'}} ›
        </view>
      </picker>
      <picker mode="selector" range="{{personnelOptions}}" bindchange="onPersonnelChange">
        <view class="filter-picker {{filterPersonnel ? 'active' : ''}}">
          {{filterPersonnel || '人员类别'}} ›
        </view>
      </picker>
      <text wx:if="{{filterName || filterSubject || filterPersonnel}}" class="filter-clear" hover-class="tap-hover" bindtap="clearFilters">重置</text>
    </view>

    <view wx:if="{{filteredTeachers.length}}">
      <view
        wx:for="{{filteredTeachers}}"
        wx:key="teacherId"
        class="card teacher-card"
      >
        <view class="tc-head" hover-class="tap-hover" data-id="{{item.teacherId}}" bindtap="toggle">
          <view class="tc-left">
            <view class="tc-name">
              {{item.teacherName}}
              <text wx:if="{{item.personnelType}}" class="pt pt-{{item.personnelClass}}">{{item.personnelType}}</text>
            </view>
            <view class="tc-sub">{{item.affiliatedCollege}}｜{{item.totalClassCount}} 个教学班</view>
          </view>
          <view class="tc-right">
            <text class="tc-hours">{{item.totalWeeklyHours}}</text>
            <text class="tc-unit">课时/周</text>
          </view>
          <text class="arrow">{{expandedId === item.teacherId ? '∨' : '›'}}</text>
        </view>

        <view wx:if="{{expandedId === item.teacherId}}" class="tc-detail">
          <view class="td-meta">
            <text class="tag tag-level">层次：{{item.levelNames}}</text>
            <text class="tag tag-college">学院：{{item.collegeNames}}</text>
            <text class="tag tag-book">教材 {{item.textbookCount}} 种</text>
          </view>
          <view
            wx:for="{{activeDetails}}"
            wx:for-item="d"
            wx:key="courseName"
            class="course-block"
          >
            <view class="cb-title">
              <text class="cb-name">{{d.courseName}}</text>
              <text class="cb-hours">{{d.weeklyHours}} 课时/周</text>
            </view>
            <view class="cb-classes">
              <view
                wx:for="{{d.classes}}"
                wx:for-item="c"
                wx:key="className"
                class="cb-class"
              >
                <text class="cb-cname">{{c.className}}</text>
                <text wx:if="{{c.isCombined}}" class="cb-comb">合班</text>
                <text wx:if="{{c.isAuto}}" class="cb-auto">自动</text>
                <text class="cb-extra">{{c.collegeName}}·{{c.trainingLevelName}}｜教材：{{c.textbookName}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="empty">{{filterName || filterSubject || filterPersonnel ? '未找到匹配的教师' : '本学期暂无教师课时数据'}}</view>
  </block>
</view>
