.filter-bar {
  display: flex;
  align-items: center;
  padding-bottom: 16rpx;
}
.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 36rpx;
  padding: 0 24rpx;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.search-icon {
  font-size: 28rpx;
  color: #1C82F5;
  margin-right: 12rpx;
}
.filter-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  background: transparent;
  font-size: 26rpx;
  color: #1a1a1a;
}
.filter-picker {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 72rpx;
  margin-left: 16rpx;
  padding: 0 24rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #555;
}
.filter-picker.active {
  color: #1C82F5;
  background: #E8F4FD;
  border-color: #1C82F5;
}
.filter-clear {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin-left: 16rpx;
  padding: 0 24rpx;
  border: 1rpx solid #1C82F5;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #1C82F5;
  background: #fff;
}
.teacher-card {
  padding: 0 28rpx;
}
.tc-head {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}
.tc-left {
  flex: 1;
  min-width: 0;
}
.tc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
}
.pt {
  font-size: 20rpx;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
  font-weight: 400;
  border: 1rpx solid transparent;
}
/* 人员类别标签：配色对齐 WEB 端 el-tag 语义色（品牌覆写后的 success/warning/info 浅底效果） */
.pt-success {
  color: #10b981;
  background: #e7f8f2;
  border-color: #b7ead9;
}
.pt-warning {
  color: #ff6b1a;
  background: #fff0e8;
  border-color: #ffd3ba;
}
.pt-info {
  color: #64748b;
  background: #f1f5f9;
  border-color: #e2e8f0;
}
.tc-sub {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-top: 10rpx;
  line-height: 1.4;
}
.tc-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 16rpx;
}
.tc-hours {
  font-size: 40rpx;
  font-weight: 700;
  color: #1C82F5;
  line-height: 1.1;
}
.tc-unit {
  font-size: 20rpx;
  color: #8a8a8a;
}
.tc-detail {
  border-top: 1rpx solid #f0f0f0;
  padding: 20rpx 0 8rpx;
}
.td-meta {
  margin-bottom: 16rpx;
}
.course-block {
  margin-bottom: 20rpx;
}
.cb-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-top: 1rpx dashed #eee;
}
.cb-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.cb-hours {
  font-size: 24rpx;
  color: #1C82F5;
}
.cb-class {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  padding: 8rpx 0;
  font-size: 24rpx;
  color: #555;
}
.cb-cname {
  font-weight: 600;
  color: #1a1a1a;
}
.cb-comb {
  font-size: 20rpx;
  color: #1c82f5;
  background: #e8f3fe;
  border: 1rpx solid #cfe4fd;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-left: 10rpx;
}
.cb-auto {
  font-size: 20rpx;
  color: #64748b;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-left: 10rpx;
}
.cb-extra {
  width: 100%;
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 4rpx;
}
