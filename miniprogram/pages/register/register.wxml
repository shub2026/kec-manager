<view class="register">
  <view class="head">
    <view class="title">注册访客账号</view>
    <view class="subtitle">注册后由管理员激活，即可登录使用</view>
  </view>

  <view class="form card">
    <view class="field">
      <view class="field-ico ico-user"></view>
      <input
        class="input"
        placeholder="请输入用户名"
        placeholder-class="ph"
        value="{{username}}"
        maxlength="50"
        confirm-type="next"
        cursor-spacing="20"
        adjust-position
        data-field="username"
        bindinput="onField"
      />
    </view>

    <view class="field">
      <view class="field-ico ico-name"></view>
      <input
        class="input"
        placeholder="真实姓名（选填）"
        placeholder-class="ph"
        value="{{realName}}"
        maxlength="100"
        confirm-type="next"
        cursor-spacing="20"
        adjust-position
        data-field="realName"
        bindinput="onField"
      />
    </view>

    <view class="field">
      <view class="field-ico ico-mail"></view>
      <input
        class="input"
        placeholder="邮箱（选填）"
        placeholder-class="ph"
        value="{{email}}"
        type="text"
        confirm-type="next"
        cursor-spacing="20"
        adjust-position
        data-field="email"
        bindinput="onField"
      />
    </view>

    <view class="field">
      <view class="field-ico ico-lock"></view>
      <input
        class="input"
        placeholder="请设置密码（至少8位，含两种字符）"
        placeholder-class="ph"
        password="{{!showPassword}}"
        value="{{password}}"
        maxlength="128"
        confirm-type="next"
        cursor-spacing="20"
        adjust-position
        data-field="password"
        bindinput="onField"
      />
      <view class="eye {{showPassword ? 'eye-on' : ''}}" hover-class="tap-hover" role="button" aria-label="显示或隐藏密码" bindtap="togglePassword">
        <view class="eye-ico"></view>
      </view>
    </view>

    <view class="field">
      <view class="field-ico ico-lock"></view>
      <input
        class="input"
        placeholder="请再次输入密码"
        placeholder-class="ph"
        password="{{!showPassword}}"
        value="{{confirmPassword}}"
        maxlength="128"
        confirm-type="done"
        cursor-spacing="20"
        adjust-position
        data-field="confirmPassword"
        bindinput="onField"
        bindconfirm="onSubmit"
      />
    </view>

    <view wx:if="{{error}}" class="errbox">{{error}}</view>

    <view
      class="btn-primary submit {{loading ? 'is-loading' : ''}}"
      hover-class="submit-hover"
      bindtap="onSubmit"
    >注册</view>
  </view>

  <view class="tip">注册账号为访客角色，需管理员激活后登录</view>
</view>
