<view class="page">
  <!-- 顶部 Hero（复用全局 .hero 样式，视觉统一） -->
  <view class="hero">
    <view class="hero-card">
      <view class="hero-text">
        <view class="hero-title">课程查询</view>
        <view class="hero-subtitle">按课程查看各培养方案采用情况</view>
      </view>
      <view class="hero-decor"><view class="hero-ring"></view></view>
    </view>
  </view>

  <!-- 筛选栏：课程名搜索为主，科目类型筛选 -->
  <view class="filter-bar">
    <view class="search-box">
      <view class="search-ico"></view>
      <input
        class="search-input"
        placeholder="搜索课程名称"
        placeholder-class="ph"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        confirm-type="search"
      />
      <text wx:if="{{keyword}}" class="search-clear" catchtap="resetFilters">✕</text>
    </view>
    <picker class="type-picker" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
      <view class="type-picker-inner">{{typeLabel}}<text class="caret">▾</text></view>
    </picker>
  </view>

  <view wx:if="{{loading && !courses.length}}" class="loading">加载中…</view>
  <view wx:elif="{{error && !courses.length}}" class="errbox">{{error}}</view>

  <block wx:else>
    <view wx:if="{{refreshing}}" class="loading">刷新中…</view>

    <!-- 统计条：共 X 门课程，被 Y 条培养方案引用 -->
    <view class="alert-bar">
      <text class="alert-text">共 <text class="alert-num">{{totalCourses}}</text> 门课程，被 <text class="alert-num">{{totalPlans}}</text> 条培养方案引用</text>
      <text wx:if="{{keyword || courseType}}" class="alert-reset" bindtap="resetFilters">重置</text>
    </view>

    <view wx:if="{{!courses.length}}" class="empty">没有符合筛选条件的课程</view>

    <view
      wx:for="{{courses}}"
      wx:key="id"
      class="course-card"
      bindtap="toggle"
      data-id="{{item.id}}"
    >
      <view class="course-head">
        <view class="course-name-wrap">
          <text class="course-name">{{item.name}}</text>
          <text wx:if="{{item.code}}" class="course-code">{{item.code}}</text>
        </view>
        <text class="course-type {{item.typeClass}}">{{item.typeLabel}}</text>
      </view>

      <view class="course-meta">
        <text class="meta-item">采用方案 <text class="meta-num">{{item.planCount}}</text></text>
        <text class="meta-sep">·</text>
        <text class="meta-item">总课时（启用）<text class="meta-num">{{item.totalHours}}</text></text>
        <text class="course-arrow">{{item.expanded ? '收起' : '展开'}}</text>
      </view>

      <!-- 展开方案明细 -->
      <view wx:if="{{item.expanded}}" class="plan-list">
        <view wx:for="{{item.plans}}" wx:for-item="p" wx:key="planId" class="plan-row">
          <view class="plan-top">
            <text class="plan-name">{{p.planName}}</text>
            <text wx:if="{{p.version}}" class="plan-version">{{p.version}}</text>
            <text class="plan-status {{p.statusClass}}">{{p.statusLabel}}</text>
            <text wx:if="{{!p.isActive}}" class="plan-disabled">已禁用</text>
          </view>
          <view class="plan-info">
            <text class="info-tag">专业 {{p.majorName}}</text>
            <text class="info-tag">层次 {{p.trainingLevelName}}</text>
            <text class="info-tag">学院 {{p.collegeName}}</text>
            <text class="info-tag" wx:if="{{p.startSemester}}">开课 第{{p.startSemester}}-{{p.endSemester}}学期</text>
          </view>
          <!-- 各学期周课时 -->
          <view wx:if="{{p.semesters.length}}" class="sem-row">
            <view wx:for="{{p.semesters}}" wx:for-item="s" wx:key="semester" class="sem-cell">
              <text class="sem-label">第{{s.semester}}学期</text>
              <text class="sem-hours">{{s.weeklyHours}}<text class="sem-unit">课时/周</text></text>
              <text wx:if="{{s.textbooks}}" class="sem-tb">{{s.textbooks}}</text>
            </view>
          </view>
          <view class="plan-total">总课时：<text class="plan-total-num">{{p.totalHours}}</text></view>
        </view>
        <view wx:if="{{!item.plans.length}}" class="empty">该课程暂无采用方案</view>
      </view>
    </view>
  </block>
</view>
