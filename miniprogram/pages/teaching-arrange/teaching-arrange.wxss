.type-picker {
  flex-shrink: 0;
}

/* ===== 统计条 ===== */
.alert-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--success-soft);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.alert-text {
  font-size: 26rpx;
  color: var(--text-2);
}
.alert-num {
  font-weight: 700;
  color: var(--success);
  margin: 0 4rpx;
}
.alert-reset {
  font-size: 24rpx;
  color: var(--brand);
  flex-shrink: 0;
}

/* ===== 课程卡片 ===== */
.course-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.course-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.course-name-wrap {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}
.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.course-code {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-4);
  flex-shrink: 0;
}
.course-type {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  color: var(--text-3);
  background: var(--bg-subtle);
}
.course-type.blue { color: var(--brand); background: var(--brand-soft); }
.course-type.green { color: var(--success-dark); background: var(--success-soft); }

.course-meta {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-3);
}
.meta-item { display: flex; align-items: center; }
.meta-num {
  font-weight: 700;
  color: var(--text-1);
  margin-left: 6rpx;
}
.meta-sep { margin: 0 16rpx; color: var(--text-4); }
.course-arrow {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--brand);
  flex-shrink: 0;
}

/* ===== 展开方案明细 ===== */
.plan-list {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border-light);
}
.plan-rows {
  background: var(--bg-page);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.plan-row {
  padding: 20rpx;
}
.plan-row + .plan-row {
  border-top: 1rpx solid var(--border);
}
.plan-top {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.plan-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-1);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.plan-version {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: var(--text-3);
  flex-shrink: 0;
}
.plan-status {
  margin-left: 12rpx;
  font-size: 20rpx;
  padding: 3rpx 10rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.plan-status.success { color: var(--success-dark); background: var(--success-soft); }
.plan-status.warning { color: var(--warning-dark); background: var(--warning-soft); }
.plan-status.info { color: var(--text-3); background: var(--bg-subtle); }
.plan-disabled {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: var(--danger-dark);
  background: var(--danger-soft);
  padding: 3rpx 10rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.plan-info {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}
.info-tag {
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--bg-card);
  border-radius: var(--radius-sm);
  padding: 4rpx 12rpx;
}
.it-major { color: var(--teal-dark); background: var(--teal-soft); }
.it-level { color: var(--brand); background: var(--brand-soft); }
.it-college { color: var(--brand); background: var(--brand-soft); }
.it-sem { color: var(--text-2); }
.sem-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.sem-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 150rpx;
  padding: 14rpx 16rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
}
.sem-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-bottom: 6rpx;
}
.sem-hours {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand);
}
.sem-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-3);
  margin-left: 4rpx;
}
.sem-tb {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-3);
  text-align: center;
  line-height: 1.4;
}
.plan-total {
  font-size: 24rpx;
  color: var(--text-2);
  text-align: right;
}
.plan-total-num {
  font-weight: 700;
  color: var(--text-1);
}
