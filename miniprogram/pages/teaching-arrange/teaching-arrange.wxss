/* ===== 分组标题 ===== */
.group-head {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  padding: 28rpx 4rpx 16rpx;
}
.group-count {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-3);
  background: var(--bg-subtle);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-pill);
  padding: 2rpx 12rpx;
}

/* ===== 课程概览卡片 ===== */
.ov-card {
  position: relative;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.ov-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.ov-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ov-type {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--border);
  color: var(--text-3);
  background: var(--bg-subtle);
}
.ov-type.public { color: var(--brand); background: var(--brand-soft); border-color: var(--brand-border); }
.ov-type.professional { color: var(--success); background: var(--success-soft); border-color: var(--success-border); }

.ov-progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.ov-progress-label {
  font-size: 24rpx;
  color: var(--text-3);
}
.ov-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}
.ov-badge.done {
  color: var(--success);
  background: var(--success-soft);
  border: 1rpx solid var(--success-border);
}
.ov-badge.waiting {
  color: var(--warning);
  background: var(--warning-soft);
  border: 1rpx solid var(--warning-border);
}

/* 进度条 */
.ov-card .bar { margin-top: 12rpx; }
.ov-card .bar-in.done { background: var(--success); }

.ov-stats {
  display: flex;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--border);
}
.ov-stat {
  flex: 1;
  text-align: center;
}
.ov-stat + .ov-stat { border-left: 1rpx solid var(--border); }
.ov-stat-num {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  line-height: 1.2;
}
.ov-stat-num.danger { color: var(--danger); }
.ov-stat-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

/* ===== 展开明细 ===== */
.ov-detail {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border);
}
.dt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  background: var(--bg-subtle);
  border-radius: var(--radius-md);
}
.dt-row:last-child { margin-bottom: 0; }
.dt-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.dt-name {
  font-size: 26rpx;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dt-combined {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-border);
  padding: 2rpx 8rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.dt-assign {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.dt-teacher {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}
.dt-lock {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: var(--success);
  background: var(--success-soft);
  border: 1rpx solid var(--success-border);
  padding: 2rpx 8rpx;
  border-radius: var(--radius-sm);
}
.dt-auto {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-border);
  padding: 2rpx 8rpx;
  border-radius: var(--radius-sm);
}
.dt-unassigned {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-4);
}
