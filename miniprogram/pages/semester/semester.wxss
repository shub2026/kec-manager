/* 筛选器撑满整行：flex 子级是 picker 组件，内部视图取满宽 */
.filter-bar picker {
  flex: 1;
}
.filter-bar .filter-picker {
  width: 100%;
}

/* ===== 统计文字 ===== */
.count {
  font-size: 24rpx;
  color: var(--text-3);
  margin: 4rpx 0 20rpx;
}

/* ===== 班级卡片 ===== */
.class-card {
  position: relative;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
}
.class-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.class-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.class-meta {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.class-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 8rpx;
}
.class-plan {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ===== 展开课程列表：max-height 过渡替代 wx:if 瞬切 ===== */
.course-list {
  max-height: 0;
  margin-top: 0;
  padding-top: 0;
  border-top: 1rpx solid transparent;
  overflow: hidden;
  transition: max-height 0.35s ease-out, margin-top 0.25s ease-out, padding-top 0.25s ease-out, border-color 0.25s ease-out;
}
.course-list.open {
  max-height: 1600rpx;     /* 兜底值，容纳最多 8 门课程 */
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top-color: var(--border-light);
}
.course-items {
  background: var(--bg-page);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.course {
  padding: 20rpx 22rpx;
}
.course + .course {
  border-top: 1rpx solid var(--border);
}
.course-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.course-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
}
.course-hours {
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 500;
}
.course-book {
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.5;
}


