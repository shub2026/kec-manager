/* 筛选栏：与教师管理/教师课时页一致 */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 36rpx;
  padding: 0 24rpx;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.search-box:focus-within {
  border-color: #1C82F5;
  box-shadow: 0 0 0 2rpx rgba(28, 130, 245, 0.12);
}
.search-icon {
  font-size: 28rpx;
  color: #1C82F5;
  margin-right: 12rpx;
}
.search-clear {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 0 4rpx 0 12rpx;
  line-height: 1;
}
.filter-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  background: transparent;
  font-size: 26rpx;
  color: #1a1a1a;
}
.filter-input .placeholder,
.filter-input::placeholder {
  color: #94a3b8;
  font-size: 26rpx;
}
.filter-picker {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #555;
}
.filter-picker.active {
  color: #1C82F5;
  background: #E8F4FD;
  border-color: #1C82F5;
}
.filter-clear {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 24rpx;
  border: 1rpx solid #1C82F5;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #1C82F5;
  background: #fff;
}

/* 局部刷新提示（搜索/筛选时不卸载搜索框） */
.top-loading {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.top-loading-bar {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  border: 4rpx solid #e3e6ea;
  border-top-color: #1C82F5;
  border-radius: 50%;
  animation: tl-spin 0.7s linear infinite;
}
.top-loading-text {
  font-size: 24rpx;
  color: #8a8a8a;
}
@keyframes tl-spin {
  to { transform: rotate(360deg); }
}

.count {
  font-size: 24rpx;
  color: #8a8a8a;
  padding: 4rpx 28rpx 16rpx;
}

.class-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.class-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.class-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.class-meta {
  font-size: 24rpx;
  color: #8a8a8a;
}
.class-sub {
  font-size: 26rpx;
  color: #555;
  margin-top: 8rpx;
}
.class-plan {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-top: 6rpx;
}

.course-list {
  margin-top: 20rpx;
  border-top: 1rpx dashed #e8e8e8;
  padding-top: 16rpx;
}
.course {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f4f4f4;
}
.course:last-child {
  border-bottom: none;
}
.course-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.course-name {
  font-size: 28rpx;
  color: #1a1a1a;
}
.course-hours {
  font-size: 24rpx;
  color: #1C82F5;
}
.course-book {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-top: 6rpx;
}
