/* ===== 筛选栏 ===== */
.filter-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.filter-picker {
  display: inline-flex;
  align-items: center;
  background: var(--bg-subtle);
  border: none;
  border-radius: var(--radius-md);
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-2);
}
.filter-picker.active {
  color: var(--brand);
  background: var(--brand-soft);
}
.filter-clear {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

/* ===== 统计文字 ===== */
.count {
  font-size: 24rpx;
  color: var(--text-3);
  margin: 4rpx 0 20rpx;
}

/* ===== 班级卡片 ===== */
.class-card {
  position: relative;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
}
.class-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.class-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.class-meta {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.class-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 8rpx;
}
.class-plan {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ===== 展开课程列表 ===== */
.course-list {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border-light);
}
.course {
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 20rpx 22rpx;
  margin-bottom: 12rpx;
}
.course:last-child { margin-bottom: 0; }
.course-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.course-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
}
.course-hours {
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 500;
}
.course-book {
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.5;
}

/* ===== 顶部加载提示 ===== */
.top-loading {
  margin-bottom: 16rpx;
}
.top-loading-bar {
  height: 4rpx;
  background: var(--brand);
  border-radius: 2rpx;
  margin-bottom: 8rpx;
  animation: shimmer 1s infinite;
}
.top-loading-text {
  font-size: 22rpx;
  color: var(--text-4);
  text-align: center;
  display: block;
}
@keyframes shimmer {
  0% { opacity: 0.5; }
  50% { opacity: 1; }
  100% { opacity: 0.5; }
}
