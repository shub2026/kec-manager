.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #07c160, #06ad56);
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.25);
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff;
  color: #07c160;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.user-info {
  flex: 1;
}
.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}
.user-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}
.logout-wrap {
  padding: 12rpx 8rpx;
}
.logout-btn {
  width: 100%;
  background: #fff;
}
