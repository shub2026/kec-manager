/* 用户卡：明亮品牌蓝 + 柔光层次 + 呼吸感 */
.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #4A9FFF 0%, #1E88E5 40%, #1565C0 100%);
  border-radius: var(--radius-xl);
  padding: 56rpx 36rpx;
  margin-bottom: 20rpx;
  box-shadow:
    0 20rpx 56rpx rgba(30, 136, 229, 0.28),
    0 6rpx 16rpx rgba(15, 23, 42, 0.06);
  position: relative;
  overflow: hidden;
}
/* 左上角大光晕 */
.user-card::before {
  content: "";
  position: absolute;
  top: -80rpx;
  left: -60rpx;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18) 0%, transparent 70%);
  pointer-events: none;
}
/* 右下角次光晕 */
.user-card::after {
  content: "";
  position: absolute;
  bottom: -50rpx;
  right: -40rpx;
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, transparent 65%);
  pointer-events: none;
}
.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.24);
  border: 2rpx solid rgba(255, 255, 255, 0.38);
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  margin-right: 28rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.10);
}
.user-info {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}
.user-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 14rpx;
  letter-spacing: -0.3rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}
.user-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.82);
}

.logout-wrap {
  margin-top: 28rpx;
}
.value-link {
  color: var(--brand) !important;
}
.logout-btn {
  width: 100%;
  height: 92rpx;
  line-height: 90rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.logout-btn::after { border: none; }
