# JWT 密钥（必须修改为随机字符串）
# 生成方法：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Refresh Token 密钥（建议独立配置，不配置则派生自 JWT_SECRET）
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# JWT 下载令牌密钥（建议独立配置，不配置则派生自 JWT_SECRET）
JWT_DOWNLOAD_SECRET=your-download-secret-change-in-production

# bcrypt 密码哈希迭代次数（默认 12）
BCRYPT_ROUNDS=12

# CORS 允许的源（逗号分隔）
CORS_ORIGINS=http://localhost,http://localhost:80
