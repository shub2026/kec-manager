# 开发环境配置
NODE_ENV=development

# 服务器端口
PORT=3000

# SQLite 数据库
DATABASE_URL="file:./data/kec.db"

# JWT 密钥（生产环境请替换为随机字符串）
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_DOWNLOAD_SECRET=your-jwt-download-secret-here

# JWT 过期时间
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS 允许的源
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 日志级别
LOG_LEVEL=debug

# 文件上传大小限制（MB）
MAX_FILE_SIZE=10

# bcrypt 迭代次数
BCRYPT_ROUNDS=10

# 默认学期（系统初始化时使用）
DEFAULT_SEMESTER=2025-2026-2
