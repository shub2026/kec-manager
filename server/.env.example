# 开发环境配置
NODE_ENV=development

# 服务器端口
PORT=3002

# SQLite 数据库
DATABASE_URL="file:./data/kec.db"

# JWT 密钥（生产环境请替换为随机字符串）
# ⚠️ 生产环境部署时必须替换以下三个 JWT_SECRET 为高强度随机字符串
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_DOWNLOAD_SECRET=your-jwt-download-secret-here

# JWT 过期时间
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_DOWNLOAD_EXPIRES_IN=30s

# CORS 允许的源
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 日志级别
LOG_LEVEL=debug

# 文件上传大小限制（MB，数据导入接口）
MAX_FILE_SIZE=10

# 文档资料单文件大小上限（MB，系统管理-文档资料页）
DOCUMENT_MAX_SIZE=50

# 上传目录（文档资料存于 $UPLOAD_DIR/documents/；生产/PM2 部署应指向持久化目录，
# 未配置时默认系统临时目录，重启可能丢失）
# UPLOAD_DIR=./uploads

# bcrypt 迭代次数
BCRYPT_ROUNDS=12

# 默认学期（系统初始化时使用）
DEFAULT_SEMESTER=2025-2026-2
