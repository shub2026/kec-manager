generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id          Int      @id @default(autoincrement())
  action      String
  module      String
  operator_id Int?
  ip          String?
  details     String?
  result      String
  message     String?
  created_at  DateTime @default(now())
  users       users?   @relation(fields: [operator_id], references: [id])

  @@index([created_at(sort: Desc)])
  @@index([operator_id])
  @@index([module])
  @@index([action])
}

model classes {
  id                Int              @id @default(autoincrement())
  name              String
  enrollment_year   Int
  duration_years    Int
  major_id          Int?
  college_id        Int?
  training_level_id Int?
  student_count     Int
  custom_plan_id    Int?
  status            String           @default("active")
  is_left_school    Boolean          @default(false)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  majors               majors?                    @relation(fields: [major_id], references: [id])
  colleges             colleges?                  @relation(fields: [college_id], references: [id])
  training_levels      training_levels?           @relation(fields: [training_level_id], references: [id])
  training_plans       training_plans?            @relation(fields: [custom_plan_id], references: [id])
  teaching_assignments teaching_assignments[]

  @@index([status])
  @@index([enrollment_year])
  @@index([major_id, status])
  @@index([training_level_id])
  @@index([college_id])
  @@index([custom_plan_id])
}

model colleges {
  id                         Int                         @id @default(autoincrement())
  name                       String                      @unique
  code                       String?
  description                String?
  sort_order                 Int                         @default(0)
  created_at                 DateTime                    @default(now())
  updated_at                 DateTime                    @updatedAt
  classes                    classes[]
  training_plans             training_plans[]
  teacher_scheduling_colleges teacher_scheduling_colleges[]
  affiliated_teachers        teachers[]               @relation("teacher_affiliated_college")
}

model courses {
  id                   Int                    @id @default(autoincrement())
  name                 String
  code                 String?
  type                 String                 @default("public")
  description          String?
  sort_order           Int                    @default(0)
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  plan_courses         plan_courses[]
  teacher_courses      teacher_courses[]
  teaching_assignments teaching_assignments[]

  @@index([type])
  @@index([code])
}

model majors {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  code           String?
  description    String?
  sort_order     Int              @default(0)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  classes        classes[]
  training_plans training_plans[]
}

model plan_course_semesters {
  id             Int              @id @default(autoincrement())
  plan_course_id Int
  semester       Int
  weekly_hours   Float
  weeks_count    Int              @default(18)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  plan_courses   plan_courses     @relation(fields: [plan_course_id], references: [id], onDelete: Cascade)
  plan_textbooks plan_textbooks[]

  @@unique([plan_course_id, semester])
  @@index([semester])
}

model plan_courses {
  id                    Int                     @id @default(autoincrement())
  plan_id               Int
  course_id             Int
  start_semester        Int
  end_semester          Int
  weekly_hours          Float
  weeks_per_semester    Int                     @default(18)
  sort_order            Int                     @default(0)
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt
  plan_course_semesters plan_course_semesters[]
  training_plans        training_plans          @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  courses               courses                 @relation(fields: [course_id], references: [id])

  @@unique([plan_id, course_id])
  @@index([plan_id])
  @@index([course_id])
}

model plan_textbooks {
  id                    Int                   @id @default(autoincrement())
  semester_id           Int
  textbook_id           Int
  is_required           Boolean               @default(true)
  created_at            DateTime              @default(now())
  plan_course_semesters plan_course_semesters @relation(fields: [semester_id], references: [id], onDelete: Cascade)
  textbooks             textbooks             @relation(fields: [textbook_id], references: [id])

  @@index([semester_id])
  @@index([textbook_id])
}

model system_settings {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  value       String
  description String?
}

model textbooks {
  id             Int              @id @default(autoincrement())
  title          String
  isbn           String?
  publisher      String?
  author         String?
  edition        String?
  publish_date   String?
  price          Float?
  category       String?
  description    String?
  is_active      Boolean          @default(true)
  sort_order     Int              @default(0)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  plan_textbooks plan_textbooks[]

  @@index([is_active])
  @@index([category])
  @@index([isbn])
}

model training_levels {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  code           String?
  description    String?
  sort_order     Int              @default(0)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  classes        classes[]
  training_plans training_plans[]
  scheduling_teachers teacher_training_levels[]
}

model training_plans {
  id                Int              @id @default(autoincrement())
  name              String
  major_id          Int?
  college_id        Int?
  training_level_id Int?
  version           String?
  description       String?
  sort_order        Int              @default(0)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  classes           classes[]
  plan_courses      plan_courses[]
  majors            majors?          @relation(fields: [major_id], references: [id])
  colleges          colleges?        @relation(fields: [college_id], references: [id])
  training_levels   training_levels? @relation(fields: [training_level_id], references: [id])

  @@index([major_id])
  @@index([college_id])
  @@index([training_level_id])
}

model users {
  id            Int          @id @default(autoincrement())
  username      String       @unique
  password      String
  role          String       @default("viewer")
  real_name     String?
  email         String?
  is_active     Boolean      @default(true)
  last_login_at DateTime?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  audit_logs    audit_logs[]

  @@index([role])
}

model teachers {
  id                   Int                         @id @default(autoincrement())
  name                 String
  gender               String?
  birth_date           String?
  personnel_type       String                      @default("full_time")
  qualification_type   String?
  default_weekly_hours Float?
  status               String                      @default("active")
  sort_order           Int                         @default(0)
  created_at           DateTime                    @default(now())
  updated_at           DateTime                    @updatedAt
  affiliated_college_id  Int?
  affiliated_college   colleges?                     @relation("teacher_affiliated_college", fields: [affiliated_college_id], references: [id], onDelete: SetNull)
  courses              teacher_courses[]
  assignments          teaching_assignments[]
  scheduling_colleges  teacher_scheduling_colleges[]
  scheduling_levels    teacher_training_levels[]

  @@index([personnel_type])
  @@map("teachers")
}

model teacher_courses {
  id         Int      @id @default(autoincrement())
  teacher_id Int
  course_id  Int
  teacher    teachers @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  course     courses  @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([teacher_id, course_id])
  @@map("teacher_courses")
}

model teacher_scheduling_colleges {
  id         Int      @id @default(autoincrement())
  teacher_id Int
  college_id Int
  teacher    teachers @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  college    colleges @relation(fields: [college_id], references: [id], onDelete: Cascade)

  @@unique([teacher_id, college_id])
  @@map("teacher_scheduling_colleges")
}

model teacher_training_levels {
  id                 Int             @id @default(autoincrement())
  teacher_id         Int
  training_level_id  Int
  teacher            teachers        @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  training_level     training_levels @relation(fields: [training_level_id], references: [id], onDelete: Cascade)

  @@unique([teacher_id, training_level_id])
  @@map("teacher_training_levels")
}

model teaching_assignments {
  id           Int      @id @default(autoincrement())
  teacher_id   Int
  class_id     Int
  course_id    Int
  semester     String
  weekly_hours Float    @default(0)
  is_auto      Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  teacher      teachers @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  class        classes  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  course       courses  @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([class_id, course_id, semester])
  @@index([teacher_id])
  @@index([semester])
  @@index([course_id, semester])
  @@map("teaching_assignments")
}
