generator client {
  provider = "prisma-client-js"
}

// 当前使用 SQLite 进行生产部署，已做好切换 MySQL 的准备：
// 1. 切换步骤：将 provider 改为 "mysql"，DATABASE_URL 改为 mysql:// 连接串
// 2. 执行 npx prisma migrate deploy 应用迁移
// 3. SQLite 不支持并发写入，已通过 WAL 模式 + busy_timeout 缓解（见 lib/prisma.js）
// 4. 所有 SQL 均通过 Prisma Client 高级 API，无 SQLite 专有语法依赖
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id          Int      @id @default(autoincrement())
  action      String
  module      String
  operator_id Int?
  ip          String?
  details     String?
  result      String
  message     String?
  created_at  DateTime @default(now())
  users       users?   @relation(fields: [operator_id], references: [id], onDelete: SetNull)

  @@index([created_at(sort: Desc)])
  @@index([operator_id])
  @@index([module])
  @@index([action])
}

model classes {
  id                Int              @id @default(autoincrement())
  name              String
  enrollment_year   Int
  duration_years    Int
  major_id          Int?
  college_id        Int?
  training_level_id Int?
  student_count     Int
  custom_plan_id    Int?
  combination_id    Int?
  status            String           @default("active")
  is_left_school    Boolean          @default(false)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  majors               majors?                    @relation(fields: [major_id], references: [id], onDelete: SetNull)
  colleges             colleges?                  @relation(fields: [college_id], references: [id], onDelete: SetNull)
  training_levels      training_levels?           @relation(fields: [training_level_id], references: [id], onDelete: SetNull)
  training_plans       training_plans?            @relation(fields: [custom_plan_id], references: [id], onDelete: SetNull)
  class_combinations   class_combinations?        @relation(fields: [combination_id], references: [id], onDelete: SetNull)
  teaching_assignments teaching_assignments[]

  @@index([status])
  @@index([enrollment_year])
  @@index([major_id, status])
  @@index([training_level_id])
  @@index([college_id])
  @@index([custom_plan_id])
  @@index([is_left_school])
  @@index([combination_id])
}

// 合班教学组：同 combination_id 的班级共享一套合班关系（当前约定限定同学院）
model class_combinations {
  id         Int      @id @default(autoincrement())
  name       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  classes    classes[]

  @@index([name])
}

model colleges {
  id                         Int                         @id @default(autoincrement())
  name                       String                      @unique
  code                       String?
  description                String?
  sort_order                 Int                         @default(0)
  created_at                 DateTime                    @default(now())
  updated_at                 DateTime                    @updatedAt
  classes                    classes[]
  training_plans             training_plans[]
  teacher_scheduling_colleges teacher_scheduling_colleges[]
  affiliated_teachers        teachers[]               @relation("teacher_affiliated_college")
}

model courses {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @unique
  code                 String?
  type                 String                 @default("public")
  description          String?
  sort_order           Int                    @default(0)
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  plan_courses         plan_courses[]
  teacher_courses      teacher_courses[]
  teaching_assignments teaching_assignments[]

  @@index([type])
  @@index([code])
}

model majors {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  code           String?
  description    String?
  sort_order     Int              @default(0)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  classes        classes[]
  training_plans training_plans[]
}

model plan_course_semesters {
  id             Int              @id @default(autoincrement())
  plan_course_id Int
  semester       Int
  // Float: 业务上通常为 0.5 倍数（如 2.5 课时），SQLite 存储为 REAL（IEEE 754），精度足够
  weekly_hours   Float
  weeks_count    Int              @default(18)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  plan_courses   plan_courses     @relation(fields: [plan_course_id], references: [id], onDelete: Cascade)
  plan_textbooks plan_textbooks[]

  @@unique([plan_course_id, semester])
  @@index([semester])
}

model plan_courses {
  id                    Int                     @id @default(autoincrement())
  plan_id               Int
  course_id             Int
  start_semester        Int
  end_semester          Int
  // Float: 业务上通常为 0.5 倍数，SQLite REAL 精度足够
  weekly_hours          Float
  weeks_per_semester    Int                     @default(18)
  // 课程启用状态：false = 禁用（保留数据但不参与开课/周课时/教材推导），与教材 is_active 同语义
  is_active             Boolean                 @default(true)
  sort_order            Int                     @default(0)
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt
  plan_course_semesters plan_course_semesters[]
  training_plans        training_plans          @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  courses               courses                 @relation(fields: [course_id], references: [id], onDelete: Restrict)

  @@unique([plan_id, course_id])
  @@index([plan_id])
  @@index([course_id])
}

model plan_textbooks {
  id                    Int                   @id @default(autoincrement())
  semester_id           Int
  textbook_id           Int
  is_required           Boolean               @default(true)
  created_at            DateTime              @default(now())
  plan_course_semesters plan_course_semesters @relation(fields: [semester_id], references: [id], onDelete: Cascade)
  textbooks             textbooks             @relation(fields: [textbook_id], references: [id], onDelete: Restrict)

  @@index([semester_id])
  @@index([textbook_id])
  @@unique([semester_id, textbook_id])
}

model system_settings {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  value       String
  description String?
}

model textbooks {
  id             Int              @id @default(autoincrement())
  title          String           @unique
  isbn           String?
  publisher      String?
  author         String?
  edition        String?
  publish_date   String?
  price          Float?
  category       String?
  description    String?
  is_active      Boolean          @default(true)
  sort_order     Int              @default(0)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  plan_textbooks plan_textbooks[]

  @@index([is_active])
  @@index([category])
  @@index([isbn])
}

model training_levels {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  code           String?
  description    String?
  sort_order     Int              @default(0)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  classes        classes[]
  training_plans training_plans[]
  scheduling_teachers teacher_training_levels[]
}

model training_plans {
  id                Int              @id @default(autoincrement())
  name              String
  major_id          Int?
  college_id        Int?
  training_level_id Int?
  version           String?
  // 适用入学年份范围（含边界）：null 表示不限。
  // 用于同一专业/层次下多版本方案按年级区分匹配（如 2025 级用 V1.0、2026 级用 V2.0）。
  apply_from_year   Int?
  apply_to_year     Int?
  description       String?
  sort_order        Int              @default(0)
  status            String           @default("draft") // draft | active | archived
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  classes           classes[]
  plan_courses      plan_courses[]
  majors            majors?          @relation(fields: [major_id], references: [id], onDelete: SetNull)
  colleges          colleges?        @relation(fields: [college_id], references: [id], onDelete: SetNull)
  training_levels   training_levels? @relation(fields: [training_level_id], references: [id], onDelete: SetNull)

  @@index([major_id])
  @@index([college_id])
  @@index([training_level_id])
}

model users {
  id                   Int          @id @default(autoincrement())
  username             String       @unique
  password             String
  role                 String       @default("viewer")
  real_name            String?
  email                String?
  is_active            Boolean      @default(true)
  must_change_password Boolean      @default(false)
  // SEC-H1: 令牌版本号，重置密码/吊销会话时自增，使所有已签发令牌失效
  token_version        Int          @default(0)
  // SEC-M4: 账号锁定字段，连续登录失败达到阈值后短期锁定
  failed_login_count   Int          @default(0)
  locked_until         DateTime?
  last_login_at        DateTime?
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt
  audit_logs           audit_logs[]

  @@index([role])
  @@index([locked_until])
}

model teachers {
  id                   Int                         @id @default(autoincrement())
  name                 String
  gender               String?
  birth_date           String?
  personnel_type       String                      @default("full_time")
  remark               String?
  default_weekly_hours Float?
  status               String                      @default("active")
  sort_order           Int                         @default(0)
  created_at           DateTime                    @default(now())
  updated_at           DateTime                    @updatedAt
  affiliated_college_id  Int?
  affiliated_college   colleges?                     @relation("teacher_affiliated_college", fields: [affiliated_college_id], references: [id], onDelete: SetNull)
  courses              teacher_courses[]
  assignments          teaching_assignments[]
  scheduling_colleges  teacher_scheduling_colleges[]
  scheduling_levels    teacher_training_levels[]

  @@index([personnel_type])
  @@index([status])
  @@index([affiliated_college_id])
  @@map("teachers")
}

model teacher_courses {
  id         Int      @id @default(autoincrement())
  teacher_id Int
  course_id  Int
  teacher    teachers @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  course     courses  @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([teacher_id, course_id])
  @@map("teacher_courses")
}

model teacher_scheduling_colleges {
  id         Int      @id @default(autoincrement())
  teacher_id Int
  college_id Int
  teacher    teachers @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  college    colleges @relation(fields: [college_id], references: [id], onDelete: Cascade)

  @@unique([teacher_id, college_id])
  @@map("teacher_scheduling_colleges")
}

model teacher_training_levels {
  id                 Int             @id @default(autoincrement())
  teacher_id         Int
  training_level_id  Int
  teacher            teachers        @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  training_level     training_levels @relation(fields: [training_level_id], references: [id], onDelete: Cascade)

  @@unique([teacher_id, training_level_id])
  @@map("teacher_training_levels")
}

model teaching_assignments {
  id           Int      @id @default(autoincrement())
  teacher_id   Int
  class_id     Int
  course_id    Int
  semester     String
  weekly_hours Float    @default(0)
  is_auto      Boolean  @default(true)
  is_locked    Boolean  @default(false)
  is_inherent  Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  teacher      teachers @relation(fields: [teacher_id], references: [id], onDelete: Restrict)
  class        classes  @relation(fields: [class_id], references: [id], onDelete: Restrict)
  course       courses  @relation(fields: [course_id], references: [id], onDelete: Restrict)

  @@unique([class_id, course_id, semester])
  @@index([teacher_id])
  @@index([semester])
  @@index([course_id, semester])
  @@index([class_id, semester])
  @@index([teacher_id, semester])
  @@map("teaching_assignments")
}


model token_blacklist {
  id         Int      @id @default(autoincrement())
  jti        String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([expires_at])
}

// B-01 修复：排课并发锁表，支持多进程/多实例部署的跨进程互斥
// F9 修复：增加 owner 列标识锁持有者，防止过期锁被误释放
model arrange_locks {
  id         Int      @id @default(autoincrement())
  lock_key   String   @unique
  owner      String   @default("")
  created_at DateTime @default(now())
  expires_at DateTime
}
