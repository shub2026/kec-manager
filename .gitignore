*.db-shm
# 生产数据目录（Docker 绑定挂载 ./data），禁止 git clean 误删运行中的
# SQLite WAL/SHM 热文件，否则主库与 WAL 失联会导致 "database disk image is malformed"
/data/
uploads/*
!uploads/.gitkeep
.env
.env.local
.DS_Store
.workbuddy/
.qoder/
.arts/

# 开发期产物（不应入库）
server/prisma/data/
client/.prodcheck/
client/dist-verify/
server/src/utils/__tmp_*
logs/

# 微信小程序开发者工具本地私有配置（含本机路径，不入库）
miniprogram/project.private.config.json
